+// Count Falcon seal signers (verified with noble Falcon) over the last N blocks. Usage: node seal-signers.mjs [N] [rpcPort]
+import * as C from '../explorer/falcon-verify-core.mjs';
+const N = Number(process.argv[2] || 20), port = process.argv[3] || 18601;
+const rpc = async (m, p = []) => (await (await fetch(`http://127.0.0.1:${port}/`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: m, params: p }) })).json()).result;
+const top = parseInt(await rpc('eth_blockNumber'), 16), cnt = {}; let bad = 0, prev = await rpc('eth_getBlockByNumber', ['0x' + (top - N).toString(16), false]);
+for (let n = top - N + 1; n <= top; n++) {
+  const b = await rpc('eth_getBlockByNumber', ['0x' + n.toString(16), false]);
+  const r = C.verifyFalconBlock(b, C.decodeExtra(prev.extraData).validators, { parent: prev });
+  if (!r.ok) bad++; for (const a of r.validSigners) cnt[a] = (cnt[a] || 0) + 1; prev = b;
+}
+console.log(JSON.stringify({ from: top - N + 1, to: top, failedBlocks: bad, signers: cnt, validators: C.decodeExtra(prev.extraData).validators.length }));
diff --git a/zeronyth/falcon-net/tools/stop-node.sh b/zeronyth/falcon-net/tools/stop-node.sh
