+#!/bin/bash
+# Rolling restart of one test-net node, then wait until it is back at the head.
+N=/workspace/falcon-qbft/net; i=$1
+$N/tools/stop-node.sh $i || exit 1
+$N/start-node.sh $i || exit 1
+rpc(){ curl -s -m 2 -X POST 127.0.0.1:$1 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber","params":[]}' | sed -n 's/.*"result":"\(0x[0-9a-f]*\)".*/\1/p'; }
+for t in $(seq 120); do
+  h=$(rpc $((18600+i))); o=$(rpc $((18600 + (i % 4) + 1)))
+  if [ -n "$h" ] && [ -n "$o" ] && [ $((h)) -ge $(( $((o)) - 1 )) ]; then echo "node$i back at $((h)) (peer $((o))) after ${t}s"; exit 0; fi
+  sleep 1
+done; echo "node$i not synced after 120s"; exit 1
