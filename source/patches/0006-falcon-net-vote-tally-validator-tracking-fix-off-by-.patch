diff --git a/zeronyth/falcon-net/tools/endurance.mjs b/zeronyth/falcon-net/tools/endurance.mjs
new file mode 100644
index 0000000..fdfad5b
--- /dev/null
+++ b/zeronyth/falcon-net/tools/endurance.mjs
@@ -0,0 +1,75 @@
+// Endurance test for the isolated Falcon-QBFT test net (chain 912701 ONLY). Resumable via state file.
+// env: END_HOURS (default 12), END_CYCLE_S (30), END_RESTART_MIN (30), END_TX_PER_CYCLE (20)
+import { readFileSync, writeFileSync, existsSync, appendFileSync } from 'node:fs';
+import { execFileSync } from 'node:child_process';
+import { keccak_256, secp256k1 } from './vendor/vendor-noble.mjs';
+import { rlpEncode, hexToBytes, bytesToHex } from './vendor/light-client.mjs';
+const N = '/workspace/falcon-qbft/net', STATE = `${N}/endurance/state.json`, LOG = '/workspace/falcon-qbft/logs/endurance-1.log';
+const HOURS = Number(process.env.END_HOURS || 12), CYCLE = Number(process.env.END_CYCLE_S || 30) * 1000;
+const RESTART_MS = Number(process.env.END_RESTART_MIN || 30) * 60000, TXN = Number(process.env.END_TX_PER_CYCLE || 20);
+const CHAIN_ID = 912701n, PORTS = [18601, 18602, 18603, 18604];
+writeFileSync(`${N}/endurance/endurance.pid`, String(process.pid));
+const log = (o) => appendFileSync(LOG, JSON.stringify({ t: new Date().toISOString(), ...o }) + '\n');
+let id = 1;
+async function rpc(port, method, params = []) {
+  const r = await fetch(`http://127.0.0.1:${port}/`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: id++, method, params }), signal: AbortSignal.timeout(5000) });
+  const j = await r.json(); if (j.error) throw new Error(method + ': ' + j.error.message); return j.result;
+}
+const big = (n) => { n = BigInt(n); if (n === 0n) return new Uint8Array(0); let h = n.toString(16); if (h.length % 2) h = '0' + h; return hexToBytes(h); };
+const addrOf = (priv) => bytesToHex(keccak_256(secp256k1.getPublicKey(priv, false).subarray(1)).subarray(12));
+function signTx(priv, nonce, to, value) {
+  const base = [big(nonce), big(0), big(21000), hexToBytes(to), big(value), new Uint8Array(0)];
+  const sig = secp256k1.sign(keccak_256(rlpEncode([...base, big(CHAIN_ID), big(0), big(0)])), priv);
+  return bytesToHex(rlpEncode([...base, big(CHAIN_ID * 2n + 35n + BigInt(sig.recovery)), big(sig.r), big(sig.s)]));
+}
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+// throwaway test sender derived from the test-net funder key (never printed)
+const funder = hexToBytes(readFileSync(`${N}/loadgen/sender.key`, 'utf8').trim());
+const sender = keccak_256(new Uint8Array([...funder, 0xe7])); const senderAddr = addrOf(sender);
+const cid = parseInt(await rpc(PORTS[0], 'eth_chainId'), 16);
+if (cid !== 912701) { log({ fatal: `chainId ${cid} is not 912701 - refusing` }); process.exit(2); }
+let st = existsSync(STATE) ? JSON.parse(readFileSync(STATE, 'utf8')) : null;
+if (!st || st.finished) {
+  st = { startedAt: Date.now(), endsAt: Date.now() + HOURS * 3600000, cycles: 0, failures: 0, failureLog: [], txSent: 0, txIncluded: 0, restarts: 0, nextRestart: Date.now() + RESTART_MS, restartIdx: 1, startHeight: null, finished: false, passed: null };
+  const fn = BigInt(await rpc(PORTS[0], 'eth_getTransactionCount', [addrOf(funder), 'pending']));
+  await rpc(PORTS[0], 'eth_sendRawTransaction', [signTx(funder, fn, senderAddr, 10n ** 22n)]);
+  for (let t = 0; t < 60 && BigInt(await rpc(PORTS[0], 'eth_getBalance', [senderAddr, 'latest'])) === 0n; t++) await sleep(1000);
+  log({ event: 'start', hours: HOURS, sender: senderAddr });
+} else log({ event: 'resume', cycles: st.cycles });
+const save = () => writeFileSync(STATE, JSON.stringify(st, null, 1));
+const fail = (msg) => { st.failures++; st.failureLog.push({ t: new Date().toISOString(), msg }); if (st.failureLog.length > 200) st.failureLog.shift(); log({ FAIL: msg }); };
+const rss = (i) => { try { const p = readFileSync(`${N}/node${i}.pid`, 'utf8').trim(); return Math.round(Number(/VmRSS:\s+(\d+)/.exec(readFileSync(`/proc/${p}/status`, 'utf8'))[1]) / 1024); } catch { return null; } };
+let stop = false; process.on('SIGTERM', () => { stop = true; }); process.on('SIGINT', () => { stop = true; });
+let lastHeight = null, pending = [];
+while (!stop && Date.now() < st.endsAt) {
+  const c = { cycle: ++st.cycles };
+  try {
+    const hs = await Promise.all(PORTS.map((p) => rpc(p, 'eth_blockNumber').then((h) => parseInt(h, 16)).catch(() => null)));
+    c.heights = hs; const live = hs.filter((h) => h !== null); const min = Math.min(...live);
+    if (st.startHeight === null) st.startHeight = min;
+    if (live.length < 4) { st.rpcWarnings = (st.rpcWarnings || 0) + 1; log({ WARN: `only ${live.length}/4 nodes answer RPC within 5 s` }); }
+    if (Math.max(...live) - min > 3) fail(`height spread ${Math.max(...live) - min}`);
+    if (lastHeight !== null && min <= lastHeight) fail(`no progress (min height ${min} <= ${lastHeight})`);
+    lastHeight = min;
+    const hashes = await Promise.all(PORTS.map((p) => rpc(p, 'eth_getBlockByNumber', ['0x' + (min - 1).toString(16), false]).then((b) => b && b.hash).catch(() => null)));
+    if (new Set(hashes.filter(Boolean)).size !== 1) fail(`hash mismatch at ${min - 1}`);
+    c.rssMiB = [1, 2, 3, 4].map(rss);
+    // previous batch inclusion
+    if (pending.length) { const rc = await Promise.all(pending.map((h) => rpc(PORTS[0], 'eth_getTransactionReceipt', [h]).catch(() => null)));
+      const ok = rc.filter((r) => r && r.status === '0x1').length; st.txIncluded += ok; if (ok !== pending.length) fail(`only ${ok}/${pending.length} txs of previous batch included`); }
+    let n = BigInt(await rpc(PORTS[0], 'eth_getTransactionCount', [senderAddr, 'pending']));
+    pending = []; for (let k = 0; k < TXN; k++) pending.push(await rpc(PORTS[k % 4], 'eth_sendRawTransaction', [signTx(sender, n++, senderAddr, 1n)]));
+    st.txSent += TXN;
+    if (Date.now() >= st.nextRestart) {
+      const i = st.restartIdx; c.restart = i;
+      try { c.restartOut = execFileSync(`${N}/tools/restart-node.sh`, [String(i)], { encoding: 'utf8', timeout: 240000 }).trim().split('\n').pop(); st.restarts++; }
+      catch (e) { fail(`restart node${i} failed: ${String(e.stdout || e.message).slice(-200)}`); }
+      st.restartIdx = (i % 4) + 1; st.nextRestart = Date.now() + RESTART_MS; lastHeight = null;
+    }
+  } catch (e) { if (/fetch failed|timeout|aborted/i.test(e.message)) { st.rpcWarnings = (st.rpcWarnings || 0) + 1; log({ WARN: 'cycle rpc error: ' + e.message }); pending = []; } else fail('cycle error: ' + e.message); }
+  c.failures = st.failures; log(c); save();
+  for (let w = 0; w < CYCLE && !stop; w += 1000) await sleep(1000);
+}
+if (!stop) { st.finished = true; st.passed = st.failures === 0; log({ event: 'finished', passed: st.passed, failures: st.failures, cycles: st.cycles, txSent: st.txSent, txIncluded: st.txIncluded, restarts: st.restarts }); }
+else log({ event: 'stopped (resumable)', cycles: st.cycles });
+save();
