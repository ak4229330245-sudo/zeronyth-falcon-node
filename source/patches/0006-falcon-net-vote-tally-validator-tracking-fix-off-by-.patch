+#!/bin/bash
+# endurance.sh start|stop|status|reset   (chain 912701 test net only; resumable)
+N=/workspace/falcon-qbft/net; D=$N/endurance; mkdir -p $D; PID=$D/endurance.pid
+running(){ [ -f $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; }
+case "$1" in
+ start) running && { echo "already running pid $(cat $PID)"; exit 0; }
+   cd $N/tools && (setsid nohup node endurance.mjs >> /workspace/falcon-qbft/logs/endurance-1.stdout 2>&1 &); sleep 2; echo "started pid $(cat $PID)";;
+ stop) running && { kill -TERM "$(cat $PID)"; for t in $(seq 30); do running || break; sleep 1; done; echo stopped; } || echo "not running";;
+ status) running && echo "RUNNING pid $(cat $PID)" || echo "NOT RUNNING"
+   [ -f $D/state.json ] && python3 -c "
+import json,time;s=json.load(open('$D/state.json'))
+print({k:s.get(k) for k in ['cycles','failures','rpcWarnings','txSent','txIncluded','restarts','finished','passed']});print('ends', time.strftime('%Y-%m-%d %H:%M %Z',time.localtime(s['endsAt']/1000)))
+print('last failures', s['failureLog'][-3:])"; tail -n 2 /workspace/falcon-qbft/logs/endurance-1.log 2>/dev/null | cut -c1-300;;
+ reset) running && { echo "stop first"; exit 1; }; [ -f $D/state.json ] && mv $D/state.json $D/state.json.$(date +%s); echo reset;;
+ *) echo "usage: $0 start|stop|status|reset"; exit 1;;
+esac
