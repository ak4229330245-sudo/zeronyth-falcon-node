+#!/bin/bash
+# backup <i...> : copy ENCRYPTED Falcon keys + sha256/address manifest to net/backups/<ts>/ (0700/0600).
+# restore <i> <backupDir> : verify manifest then restore key for a STOPPED node.
+# Password files are deliberately NOT part of this backup (store them separately/offline).
+set -euo pipefail; umask 077
+N=/workspace/falcon-qbft/net; K=$N/tools/falcon-key.sh
+case "${1:-}" in
+backup) shift; B=$N/backups/$(date +%Y%m%dT%H%M%S); mkdir -p $B; chmod 700 $N/backups $B
+  for i in "$@"; do f=$N/node$i/data/falcon1024.key
+    grep -q '^format=falcon1024-enc-v1' $f || { echo "node$i key not encrypted - refusing to back up plaintext"; exit 1; }
+    cp $f $B/node$i.falcon1024.key; chmod 600 $B/node$i.falcon1024.key
+    echo "node$i $(sha256sum < $f | cut -c1-64) $($K info $f | grep ^address= | cut -d= -f2)" >> $B/MANIFEST; done
+  chmod 600 $B/MANIFEST; echo "backup at $B"; cat $B/MANIFEST ;;
+restore) i=$2; B=$3; f=$N/node$i/data/falcon1024.key
+  p=$(cat $N/node$i.pid 2>/dev/null || true); if [ -n "$p" ] && kill -0 $p 2>/dev/null; then echo "node$i is running - stop it first"; exit 1; fi
+  read -r _ sum addr < <(grep "^node$i " $B/MANIFEST)
+  [ "$(sha256sum < $B/node$i.falcon1024.key | cut -c1-64)" = "$sum" ] || { echo "sha256 mismatch"; exit 1; }
+  BESU_FALCON1024_KEY_PASSWORD_FILE=$N/secrets/node$i.pass $K verify $B/node$i.falcon1024.key | grep -q "^address=$addr" || { echo "decrypt/address check failed"; exit 1; }
+  cp $B/node$i.falcon1024.key $f.restore.tmp; chmod 600 $f.restore.tmp; mv $f.restore.tmp $f; echo "node$i restored from $B ($addr)" ;;
+*) echo "usage: key-backup.sh backup <i...> | restore <i> <dir>"; exit 2 ;;
+esac
