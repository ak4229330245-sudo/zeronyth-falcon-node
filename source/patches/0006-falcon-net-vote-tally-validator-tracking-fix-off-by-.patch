@@ -0,0 +1,11 @@
+#!/bin/bash
+# start|stop|status the local explorer + verify API (127.0.0.1:18780, chain 912701 test net only)
+D=/workspace/falcon-qbft/net/explorer; P=$D/explorer.pid; L=/workspace/falcon-qbft/net/logs/explorer.log
+case "$1" in
+start) if [ -f $P ] && kill -0 $(cat $P) 2>/dev/null; then echo "already running $(cat $P)"; exit 0; fi
+  (cd /workspace/falcon-qbft/jsdeps && ./node_modules/.bin/esbuild $D/app.mjs --bundle --format=esm --minify --outfile=$D/dist/app.js --log-level=warning)
+  nohup node $D/server.mjs >> $L 2>&1 & echo $! > $P; sleep 1; tail -1 $L ;;
+stop) [ -f $P ] && kill $(cat $P) 2>/dev/null; rm -f $P; echo stopped ;;
+status) [ -f $P ] && kill -0 $(cat $P) 2>/dev/null && echo "running pid $(cat $P)" || echo "not running" ;;
+*) echo "usage: ctl.sh start|stop|status" ;;
+esac
diff --git a/zeronyth/falcon-net/explorer/falcon-verify-core.mjs b/zeronyth/falcon-net/explorer/falcon-verify-core.mjs
new file mode 100644
index 0000000..5814442
--- /dev/null
+++ b/zeronyth/falcon-net/explorer/falcon-verify-core.mjs
@@ -0,0 +1,156 @@
+// ZERONYTH Falcon-1024 QBFT verification core (browser + Node, no secrets, no network).
+// Algorithm: BouncyCastle bcprov 1.84 "Falcon-1024" = Falcon ROUND-3 submission (NOT FIPS 206 FN-DSA).
+// Verified here with @noble/post-quantum falcon1024 (also round-3; cross-checked against BC seals).
+// ML-DSA-65 (FIPS 204) finality certificates are verified with the existing pq-finality-core.
+import { falcon1024 } from '@noble/post-quantum/falcon.js';
+import { keccak_256 } from '@noble/hashes/sha3.js';
+import { decodeExtra, qbftBlockHash, qbftSealHash, quorumSize, validatorSetHash, hexToBytes, bytesToHex } from '../tools/vendor/light-client.mjs';
+import { ml_dsa65, b64, finalityMessage, pqSetHash, bindingHash, pqQuorum } from '../tools/vendor/pq-finality-core.mjs';
+
+export const ALGORITHM = 'Falcon-1024 (round-3, BouncyCastle bcprov 1.84 compatible) - NOT FIPS 206 FN-DSA';
+export const ENVELOPE = 'ZQBFv1';
+export const TEST_CHAIN_ID = 912701;
+export const PRODUCTION_CHAIN_IDS = [9127];
+export const TYPES = { 1: 'PROPOSAL', 2: 'PREPARE', 3: 'COMMIT', 4: 'ROUND_CHANGE', 5: 'COMMIT_SEAL', 6: 'PQ_BINDING' };
+export const COMMIT_SEAL = 5, PQ_BINDING = 6;
+const DOMAIN = new TextEncoder().encode('ZERONYTH/QBFT/FALCON-1024/V1\0');
+const MAGIC = [0x5a, 0x51, 0x42, 0x46]; // "ZQBF"
+export const RAW_PUB_LEN = 1792, NOBLE_PUB_HEADER = 0x0a;
+export { decodeExtra, qbftBlockHash, qbftSealHash, quorumSize, validatorSetHash, hexToBytes, bytesToHex, pqQuorum };
+
+const u8 = (x) => (typeof x === 'string' ? hexToBytes(x) : x);
+export const addressOfFalconPub = (rawPub) => bytesToHex(keccak_256(u8(rawPub)).subarray(12)).toLowerCase();
+export const toNoblePub = (rawPub) => { const p = u8(rawPub); if (p.length === 1793 && p[0] === NOBLE_PUB_HEADER) return p; if (p.length !== RAW_PUB_LEN) throw new Error(`Falcon-1024 public key must be ${RAW_PUB_LEN} bytes (raw h)`); const o = new Uint8Array(1793); o[0] = NOBLE_PUB_HEADER; o.set(p, 1); return o; };
+
+export function parseEnvelope(bytes) {
+  const b = u8(bytes);
+  if (b.length < 64) throw new Error('envelope too short');
+  for (let i = 0; i < 4; i++) if (b[i] !== MAGIC[i]) throw new Error('bad magic');
+  if (b[4] !== 1) throw new Error('unsupported envelope version');
+  const dv = new DataView(b.buffer, b.byteOffset, b.byteLength);
+  const type = b[5], chainId = dv.getBigUint64(6), height = dv.getBigUint64(14), round = dv.getUint32(22);
+  const payloadHash = b.slice(26, 58), pubLen = dv.getUint16(58);
+  if (pubLen !== RAW_PUB_LEN) throw new Error('bad public key length');
+  if (b.length < 62 + pubLen) throw new Error('truncated');
+  const pub = b.slice(60, 60 + pubLen), sigLen = dv.getUint16(60 + pubLen), sig = b.slice(62 + pubLen);
+  if (sig.length !== sigLen || sigLen === 0 || sigLen > 1462) throw new Error('bad signature length');
+  return { type, typeName: TYPES[type] || 'UNKNOWN', chainId, height, round, payloadHash, pub, sig };
+}
+
+export function signingBytes(chainId, type, height, round, payloadHash) {
+  const m = new Uint8Array(DOMAIN.length + 56), v = new DataView(m.buffer);
+  m.set(DOMAIN); let o = DOMAIN.length;
+  v.setBigUint64(o, BigInt(chainId)); v.setUint32(o + 8, type); v.setBigUint64(o + 12, BigInt(height)); v.setUint32(o + 20, round);
+  const ph = u8(payloadHash); if (ph.length !== 32) throw new Error('payloadHash must be 32 bytes'); m.set(ph, o + 24);
+  return m;
+}
+
+export function falconVerifyRaw(rawPub, message, sig) {
+  try { return falcon1024.verify(u8(sig), u8(message), toNoblePub(rawPub)) === true; } catch { return false; }
+}
+
+// Verifies one ZQBF envelope against expected context. Never throws; returns {ok, reason, address}.
+export function verifyEnvelope(envBytes, expect) {
+  let e;
+  try { e = parseEnvelope(envBytes); } catch (x) { return { ok: false, reason: `malformed: ${x.message}` }; }
+  const address = addressOfFalconPub(e.pub);
+  const fail = (reason) => ({ ok: false, reason, address, type: e.typeName });
+  if (expect.chainId !== undefined && e.chainId !== BigInt(expect.chainId)) return fail(`wrong chainId ${e.chainId}`);
+  if (PRODUCTION_CHAIN_IDS.includes(Number(e.chainId))) return fail('production chain id refused');
+  if (expect.type !== undefined && e.type !== expect.type) return fail(`wrong type ${e.typeName}`);
+  if (expect.height !== undefined && e.height !== BigInt(expect.height)) return fail(`wrong height ${e.height}`);
+  if (expect.round !== undefined && e.round !== expect.round) return fail(`wrong round ${e.round}`);
+  if (expect.payloadHash !== undefined && bytesToHex(e.payloadHash) !== bytesToHex(u8(expect.payloadHash))) return fail('payload hash mismatch (seal for another block / replay)');
+  if (expect.allowed && !expect.allowed.has(address)) return fail('signer is not in the trusted validator set');
+  if (!falconVerifyRaw(e.pub, signingBytes(e.chainId, e.type, e.height, e.round, e.payloadHash), e.sig)) return fail('Falcon-1024 signature INVALID');
+  return { ok: true, reason: 'valid', address, type: e.typeName, sigLen: e.sig.length, publicKeyHex: bytesToHex(e.pub) };
+}
+
+// Verifies a block's Falcon COMMIT seals against a trusted validator set (from the verified parent).
+// QBFT header-vote validator tracking (mirrors Besu VoteTallyUpdater/VoteTally):
+//  - validators(N) = validators after applying the votes of blocks <= N-1 (this is what block N's extraData lists
+//    and what must sign block N's COMMIT seals);
+//  - proposer = header coinbase; ADD = 0xff, DROP = empty; a change applies when votes from > n/2 distinct
+//    validators agree; outstanding votes for that subject are then discarded; epoch blocks reset all votes.
+export class ValidatorTracker {
+  constructor(validators, epochLength = 30000) { this.validators = new Set(validators.map((a) => a.toLowerCase())); this.epochLength = epochLength; this.addVotes = new Map(); this.dropVotes = new Map(); }
+  current() { return [...this.validators].sort(); }
+  clone() { const t = new ValidatorTracker([], this.epochLength); t.validators = new Set(this.validators); for (const k of ['addVotes', 'dropVotes']) t[k] = new Map([...this[k]].map(([a, v]) => [a, new Set(v)])); return t; }
+  #discard(subject) { this.addVotes.delete(subject); this.dropVotes.delete(subject); }
+  apply(number, coinbase, vote) {
+    if (number % this.epochLength === 0) { this.addVotes.clear(); this.dropVotes.clear(); return; }
+    if (!vote) return;
+    const proposer = coinbase.toLowerCase(), subject = vote.address.toLowerCase();
+    const mine = (vote.add ? this.addVotes : this.dropVotes), other = (vote.add ? this.dropVotes : this.addVotes);
+    if (!mine.has(subject)) mine.set(subject, new Set());
+    mine.get(subject).add(proposer); other.get(subject)?.delete(proposer);
+    const limit = Math.floor(this.validators.size / 2) + 1;
+    if (this.addVotes.get(subject)?.size >= limit) { this.validators.add(subject); this.#discard(subject); }
+    if (this.dropVotes.get(subject)?.size >= limit) {
+      this.validators.delete(subject); this.#discard(subject);
+      for (const m of [this.addVotes, this.dropVotes]) for (const v of m.values()) v.delete(subject);
+    }
+  }
+}
+const sameSet = (a, b) => a.length === b.length && [...a].map((x) => x.toLowerCase()).sort().join() === [...b].map((x) => x.toLowerCase()).sort().join();
+
+export function verifyFalconBlock(block, trustedValidators, { chainId = TEST_CHAIN_ID, parent = null } = {}) {
+  const res = { number: parseInt(block.number, 16), hash: block.hash, ok: false, checks: [], seals: [] };
+  const e = decodeExtra(block.extraData);
+  const hash = qbftBlockHash(block, e);
+  res.checks.push({ name: 'header hash = keccak(rlp(header))', ok: hash.toLowerCase() === block.hash.toLowerCase() });
+  if (parent) res.checks.push({ name: 'parentHash links to verified parent', ok: parent.hash.toLowerCase() === block.parentHash.toLowerCase() });
+  res.checks.push({ name: 'extraData validator list = vote-tally set for this height', ok: sameSet(e.validators, trustedValidators) });
+  const sealHash = qbftSealHash(block, e);
+  const allowed = new Set(trustedValidators.map((a) => a.toLowerCase()));
+  const signers = new Set();
+  for (const s of e.seals) {
+    const r = verifyEnvelope(s, { chainId, type: COMMIT_SEAL, height: res.number, round: e.roundNumber, payloadHash: sealHash, allowed });
+    r.duplicate = r.ok && signers.has(r.address);
+    if (r.ok && !r.duplicate) signers.add(r.address);
+    res.seals.push(r);
+  }
+  res.need = quorumSize(allowed.size); res.validatorCount = allowed.size; res.validators = [...allowed]; res.validSigners = [...signers];
+  res.checks.push({ name: `Falcon COMMIT seal quorum ${signers.size}/${res.need} of ${allowed.size}`, ok: signers.size >= res.need });
+  res.vote = e.voteParsed; res.miner = (block.miner || '').toLowerCase();
+  // NOTE: res.nextValidators must be computed by the caller with ValidatorTracker.apply(); kept here only as the claim.
+  res.claimedValidators = e.validators; res.round = e.roundNumber;
+  res.ok = res.checks.every((c) => c.ok);
+  return res;
+}
+
+// Registry: each ML-DSA-65 key is bound to its Falcon validator (Falcon PQ_BINDING + ML-DSA proof-of-possession).
+export function verifyRegistry(reg, validators, chainId = TEST_CHAIN_ID) {
+  const out = { ok: false, entries: [] };
+  if (reg.scheme !== 'ML-DSA-65' || reg.chainId !== chainId) { out.error = 'registry scheme/chain mismatch'; return out; }
+  const allowed = new Set(validators.map((a) => a.toLowerCase()));
+  for (const v of reg.validators) {
+    const pk = b64.dec(v.publicKey), h = bindingHash(v.address, pk);
+    const fb = verifyEnvelope(v.falconBinding, { chainId, type: PQ_BINDING, height: 0, round: 0, payloadHash: h });
+    const entry = { index: v.index, address: v.address.toLowerCase(), falconBinding: fb.ok && fb.address === v.address.toLowerCase(),
+      mldsaBinding: pk.length === 1952 && ml_dsa65.verify(b64.dec(v.pqBinding), h, pk), isValidator: allowed.has(v.address.toLowerCase()) };
+    entry.ok = entry.falconBinding && entry.mldsaBinding; out.entries.push(entry);
+  }
+  out.setHashOk = pqSetHash(reg.validators.map((v) => v.publicKey)) === reg.setHash;
+  out.ok = out.setHashOk && out.entries.every((e) => e.ok);
+  return out;
+}
+
+// ML-DSA-65 finality certificate for a Falcon-verified block. Never throws.
+export function verifyFinalityCert(cert, reg, block, falconResult) {
+  const checks = [];
+  const push = (name, ok) => checks.push({ name, ok: !!ok });
+  push('certificate chainId/pqSetHash match registry', cert.scheme === 'ML-DSA-65' && cert.chainId === reg.chainId && cert.pqSetHash === reg.setHash);
+  push('certificate binds this block hash', cert.height === parseInt(block.number, 16) && cert.blockHash === block.hash.toLowerCase());
+  push('certificate validatorSetHash = verified next set', falconResult && cert.validatorSetHash === validatorSetHash(falconResult.nextValidators));
+  const msg = finalityMessage(cert), seen = new Set();
+  for (const s of cert.signatures || []) {
+    const v = reg.validators[s.index];
+    // only attesters bound to a CURRENT Falcon validator of this block count toward PQ quorum
+    const current = !falconResult?.validators || falconResult.validators.includes(v?.address?.toLowerCase());
+    if (v && current && !seen.has(s.index) && ml_dsa65.verify(b64.dec(s.signature), msg, b64.dec(v.publicKey))) seen.add(s.index);
+  }
+  const need = pqQuorum(reg.validators.length);
+  push(`ML-DSA-65 signatures ${seen.size}/${need} of ${reg.validators.length}`, seen.size >= need);
+  return { ok: checks.every((c) => c.ok), checks, validSignatures: seen.size, need };
+}
