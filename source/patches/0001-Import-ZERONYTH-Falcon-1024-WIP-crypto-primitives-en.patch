diff --git a/consensus/qbft-core/src/main/java/org/hyperledger/besu/consensus/qbft/core/payload/FalconQbftPayloadAuthenticator.java b/consensus/qbft-core/src/main/java/org/hyperledger/besu/consensus/qbft/core/payload/FalconQbftPayloadAuthenticator.java
new file mode 100644
index 0000000..3724281
--- /dev/null
+++ b/consensus/qbft-core/src/main/java/org/hyperledger/besu/consensus/qbft/core/payload/FalconQbftPayloadAuthenticator.java
@@ -0,0 +1,101 @@
+/*
+ * Copyright ZERONYTH Network contributors.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.hyperledger.besu.consensus.qbft.core.payload;
+
+import org.hyperledger.besu.consensus.common.bft.ConsensusRoundIdentifier;
+import org.hyperledger.besu.consensus.common.bft.payload.Payload;
+import org.hyperledger.besu.consensus.qbft.core.messagedata.QbftV1;
+import org.hyperledger.besu.crypto.Falcon1024ConsensusCrypto;
+import org.hyperledger.besu.crypto.Falcon1024ConsensusEnvelope;
+import org.hyperledger.besu.crypto.Falcon1024ConsensusEnvelope.VerifiedMessage;
+import org.hyperledger.besu.datatypes.Hash;
+
+import java.security.SecureRandom;
+import java.util.Collection;
+
+import org.bouncycastle.pqc.crypto.falcon.FalconPrivateKeyParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters;
+
+/**
+ * Falcon-1024 authenticator for Besu's actual QBFT Payload objects.
+ *
+ * <p>All four native QBFT payload classes implement Payload. This adapter binds the existing
+ * canonical RLP payload hash to the new signed-envelope format. It is an integration building
+ * block, NOT YET plugged into Besu's MessageFactory, QbftMessageDecoder, or block-header seals.
+ * Those paths must all switch atomically on a separate experimental protocol version.
+ */
+public final class FalconQbftPayloadAuthenticator {
+  private FalconQbftPayloadAuthenticator() {}
+
+  public static byte[] sign(
+      final Payload payload,
+      final FalconPrivateKeyParameters secret,
+      final FalconPublicKeyParameters pub,
+      final SecureRandom random,
+      final long chainId) {
+    final ConsensusRoundIdentifier round = payload.getRoundIdentifier();
+    return Falcon1024ConsensusEnvelope.signAndEncode(
+        secret,
+        pub,
+        random,
+        chainId,
+        mapNativeMessageCode(payload.getMessageType()),
+        round.getSequenceNumber(),
+        round.getRoundNumber(),
+        payload.hashForSignature().getBytes().toArray());
+  }
+
+  public static VerifiedMessage verify(
+      final Payload decodedNativePayload,
+      final byte[] signedEnvelope,
+      final long expectedChainId,
+      final Collection<byte[]> allowedValidatorPublicKeys) {
+    final VerifiedMessage signed =
+        Falcon1024ConsensusEnvelope.decodeAndVerify(
+            signedEnvelope,
+            expectedChainId,
+            mapNativeMessageCode(decodedNativePayload.getMessageType()),
+            decodedNativePayload.hashForSignature().getBytes().toArray(),
+            allowedValidatorPublicKeys);
+    final ConsensusRoundIdentifier round = decodedNativePayload.getRoundIdentifier();
+    if (signed.blockHeight() != round.getSequenceNumber()
+        || signed.round() != round.getRoundNumber()) {
+      throw new IllegalArgumentException("Falcon envelope does not match native QBFT round");
+    }
+    return signed;
+  }
+
+  /**
+   * Commit seals are signed over Besu's actual committed-seal hash, distinct from COMMIT messages.
+   * Block-header serialization/verification must still be integrated separately.
+   */
+  public static byte[] signCommitSeal(
+      final Hash committedSealHash,
+      final ConsensusRoundIdentifier round,
+      final FalconPrivateKeyParameters secret,
+      final FalconPublicKeyParameters pub,
+      final SecureRandom random,
+      final long chainId) {
+    return Falcon1024ConsensusEnvelope.signAndEncode(
+        secret,
+        pub,
+        random,
+        chainId,
+        Falcon1024ConsensusCrypto.COMMIT_SEAL,
+        round.getSequenceNumber(),
+        round.getRoundNumber(),
+        committedSealHash.getBytes().toArray());
+  }
+
+  private static int mapNativeMessageCode(final int code) {
+    return switch (code) {
+      case QbftV1.PROPOSAL -> Falcon1024ConsensusCrypto.PROPOSAL;
+      case QbftV1.PREPARE -> Falcon1024ConsensusCrypto.PREPARE;
+      case QbftV1.COMMIT -> Falcon1024ConsensusCrypto.COMMIT;
+      case QbftV1.ROUND_CHANGE -> Falcon1024ConsensusCrypto.ROUND_CHANGE;
+      default -> throw new IllegalArgumentException("Unsupported native QBFT message type");
+    };
+  }
+}
diff --git a/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024CommitQuorum.java b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024CommitQuorum.java
new file mode 100644
index 0000000..0d6682f
--- /dev/null
+++ b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024CommitQuorum.java
@@ -0,0 +1,91 @@
+/*
+ * Copyright ZERONYTH Network contributors.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.hyperledger.besu.crypto;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+
+/**
+ * Strict Falcon-1024 finality-seal quorum verification for a distinct experimental QBFT network.
+ *
+ * <p>This verifies validator signatures on an independently calculated committed-seal hash.
+ * It does not replace the consensus rules, block-header codec or the actual Besu commit validator.
+ * Do not feed it a hash supplied by an untrusted wire message without recomputing that hash.
+ */
+public final class Falcon1024CommitQuorum {
+  private Falcon1024CommitQuorum() {}
+
+  /** Minimum distinct validators required to finalize a QBFT block. */
+  public static int requiredSeals(final int validatorCount) {
+    if (validatorCount <= 0) {
+      throw new IllegalArgumentException("QBFT validator set cannot be empty");
+    }
+    return (int) ((2L * validatorCount) / 3L + 1L);
+  }
+
+  /**
+   * Fail-closed quorum verification. Every supplied seal must be authentic, authorized, unique,
+   * and scoped to exactly the expected chain, block and round. Duplicate/foreign seals cannot
+   * contribute to a quorum, even when they are presented alongside valid seals.
+   */
+  public static boolean verify(
+      final Collection<byte[]> seals,
+      final Collection<byte[]> authorizedValidatorKeys,
+      final long expectedChainId,
+      final long expectedBlockHeight,
+      final int expectedRound,
+      final byte[] independentlyComputedCommittedSealHash) {
+    Objects.requireNonNull(seals, "seals");
+    Objects.requireNonNull(authorizedValidatorKeys, "authorizedValidatorKeys");
+    Objects.requireNonNull(independentlyComputedCommittedSealHash, "committedSealHash");
+    if (independentlyComputedCommittedSealHash.length != 32 || expectedChainId <= 0
+        || expectedBlockHeight < 0 || expectedRound < 0) {
+      throw new IllegalArgumentException("Invalid expected finality context");
+    }
+
+    // Reject duplicate validator keys, including bytewise equal keys in distinct arrays.
+    final Set<ByteBuffer> seenKeys = new HashSet<>();
+    final Set<ByteBuffer> seenAddresses = new HashSet<>();
+    final List<byte[]> allowlist = new ArrayList<>();
+    for (final byte[] key : authorizedValidatorKeys) {
+      if (key == null || key.length != 1792
+          || !seenKeys.add(ByteBuffer.wrap(key))
+          || !seenAddresses.add(ByteBuffer.wrap(Falcon1024ConsensusEnvelope.validatorAddress(key)))) {
+        throw new IllegalArgumentException("Invalid or duplicate Falcon validator identity");
+      }
+      allowlist.add(key.clone());
+    }
+    final int required = requiredSeals(allowlist.size());
+    if (seals.size() < required || seals.size() > allowlist.size()) {
+      return false;
+    }
+
+    final Set<ByteBuffer> verifiedAuthors = new HashSet<>();
+    for (final byte[] seal : seals) {
+      try {
+        final Falcon1024ConsensusEnvelope.VerifiedMessage verified =
+            Falcon1024ConsensusEnvelope.decodeAndVerify(
+                seal,
+                expectedChainId,
+                Falcon1024ConsensusCrypto.COMMIT_SEAL,
+                independentlyComputedCommittedSealHash,
+                allowlist);
+        if (verified.blockHeight() != expectedBlockHeight
+            || verified.round() != expectedRound
+            || !verifiedAuthors.add(ByteBuffer.wrap(verified.authorAddress()))) {
+          return false;
+        }
+      } catch (final IllegalArgumentException invalidSeal) {
+        return false;
+      }
+    }
+    return verifiedAuthors.size() >= required;
+  }
+}
diff --git a/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCrypto.java b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCrypto.java
new file mode 100644
index 0000000..6f6e741
--- /dev/null
+++ b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCrypto.java
@@ -0,0 +1,113 @@
+/*
+ * Copyright ZERONYTH Network contributors.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.hyperledger.besu.crypto;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.Arrays;
+import java.util.Objects;
+
+import org.bouncycastle.crypto.AsymmetricCipherKeyPair;
+import org.bouncycastle.crypto.params.ParametersWithRandom;
+import org.bouncycastle.pqc.crypto.falcon.FalconKeyGenerationParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconKeyPairGenerator;
+import org.bouncycastle.pqc.crypto.falcon.FalconParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPrivateKeyParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconSigner;
+
+/**
+ * Experimental Falcon-1024 primitive for a future, versioned QBFT consensus protocol.
+ *
+ * <p>This does not replace the existing Besu ECDSA signature paths by itself. It deliberately
+ * domain-separates each consensus message from every other type, network and consensus round.
+ * Only a distinct Falcon-only network/protocol version may use this encoding.
+ */
+public final class Falcon1024ConsensusCrypto {
+
+  /** QBFT PROPOSAL. */
+  public static final int PROPOSAL = 1;
+  /** QBFT PREPARE. */
+  public static final int PREPARE = 2;
+  /** QBFT COMMIT. */
+  public static final int COMMIT = 3;
+  /** QBFT ROUND_CHANGE. */
+  public static final int ROUND_CHANGE = 4;
+  /** Block header finality/commit seal; never reuse the COMMIT message signature. */
+  public static final int COMMIT_SEAL = 5;
+
+  private static final byte[] DOMAIN =
+      "ZERONYTH/QBFT/FALCON-1024/V1\u0000".getBytes(StandardCharsets.US_ASCII);
+
+  private Falcon1024ConsensusCrypto() {}
+
+  /** Generates a new Falcon-1024 signing identity. Caller must securely persist its secret key. */
+  public static AsymmetricCipherKeyPair generateKeyPair(final SecureRandom random) {
+    Objects.requireNonNull(random, "random");
+    final FalconKeyPairGenerator generator = new FalconKeyPairGenerator();
+    generator.init(new FalconKeyGenerationParameters(random, FalconParameters.falcon_1024));
+    return generator.generateKeyPair();
+  }
+
+  /**
+   * Canonical signature input; never sign an unscoped block hash or raw message bytes.
+   *
+   * @param chainId genesis network's chain ID, not the p2p network ID
+   * @param messageType one of the five constants above
+   * @param blockHeight QBFT sequence (block height)
+   * @param round QBFT round, zero or greater
+   * @param payloadHash 32-byte canonical hash of the existing QBFT payload or header
+   */
+  public static byte[] signingBytes(
+      final long chainId,
+      final int messageType,
+      final long blockHeight,
+      final int round,
+      final byte[] payloadHash) {
+    if (chainId <= 0 || blockHeight < 0 || round < 0 || messageType < PROPOSAL
+        || messageType > COMMIT_SEAL) {
+      throw new IllegalArgumentException("Invalid consensus domain values");
+    }
+    Objects.requireNonNull(payloadHash, "payloadHash");
+    if (payloadHash.length != 32) {
+      throw new IllegalArgumentException("Expected 32-byte canonical payload hash");
+    }
+    final ByteBuffer result = ByteBuffer.allocate(DOMAIN.length + 8 + 4 + 8 + 4 + 32);
+    return result.put(DOMAIN)
+        .putLong(chainId)
+        .putInt(messageType)
+        .putLong(blockHeight)
+        .putInt(round)
+        .put(payloadHash)
+        .array();
+  }
+
+  /** Signs the canonical scoped QBFT preimage with Falcon-1024. */
+  public static byte[] sign(
+      final FalconPrivateKeyParameters privateKey,
+      final SecureRandom random,
+      final byte[] signingBytes) {
+    Objects.requireNonNull(privateKey, "privateKey");
+    Objects.requireNonNull(random, "random");
+    Objects.requireNonNull(signingBytes, "signingBytes");
+    final FalconSigner signer = new FalconSigner();
+    signer.init(true, new ParametersWithRandom(privateKey, random));
+    return signer.generateSignature(Arrays.copyOf(signingBytes, signingBytes.length));
+  }
+
+  /** Verifies the canonical scoped preimage against an already allowlisted public key. */
+  public static boolean verify(
+      final FalconPublicKeyParameters publicKey,
+      final byte[] signingBytes,
+      final byte[] signature) {
+    Objects.requireNonNull(publicKey, "publicKey");
+    Objects.requireNonNull(signingBytes, "signingBytes");
+    Objects.requireNonNull(signature, "signature");
+    final FalconSigner signer = new FalconSigner();
+    signer.init(false, publicKey);
+    return signer.verifySignature(Arrays.copyOf(signingBytes, signingBytes.length), signature);
+  }
+}
diff --git a/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusEnvelope.java b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusEnvelope.java
new file mode 100644
index 0000000..d04a9ed
--- /dev/null
+++ b/crypto/algorithms/src/main/java/org/hyperledger/besu/crypto/Falcon1024ConsensusEnvelope.java
@@ -0,0 +1,227 @@
+/*
+ * Copyright ZERONYTH Network contributors.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.hyperledger.besu.crypto;
+
+import java.nio.ByteBuffer;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Objects;
+
+import org.bouncycastle.crypto.digests.KeccakDigest;
+import org.bouncycastle.pqc.crypto.falcon.FalconParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPrivateKeyParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters;
+
+/**
+ * Versioned, strict Falcon-1024 consensus-authentication envelope.
+ *
+ * <p>This envelope authenticates the canonical hash of an actual QBFT payload; it does not
+ * encode the payload itself, nor implement QBFT transport/finality. Validators MUST recompute
+ * the payload hash and independently check block height, round, and 3-of-4 quorum. The
+ * authorized public-key registry MUST be anchored to the intended genesis/validator set.
+ *
+ * <p>Wire v1: magic(4), version(1), messageType(1), chainId(8), height(8), round(4),
+ * payloadHash(32), keySize(2), Falcon1024-key(1792), signatureSize(2), Falcon-signature.
+ * The encoder is intended exclusively for an explicitly versioned experimental QBFT network.
+ */
+public final class Falcon1024ConsensusEnvelope {
+  private static final byte[] MAGIC = {'Z', 'Q', 'B', 'F'};
+  private static final byte VERSION = 1;
+  private static final int HEADER_SIZE = MAGIC.length + 1 + 1 + 8 + 8 + 4 + 32 + 2;
+  private static final int PUBLIC_KEY_LENGTH = 1792;
+  private static final int MAX_SIGNATURE_LENGTH = 2048;
+
+  private Falcon1024ConsensusEnvelope() {}
+
+  /** Sign a QBFT message's canonical 32-byte payload or block-header hash. */
+  public static byte[] signAndEncode(
+      final FalconPrivateKeyParameters secret,
+      final FalconPublicKeyParameters pub,
+      final SecureRandom random,
+      final long chainId,
+      final int messageType,
+      final long blockHeight,
+      final int round,
+      final byte[] payloadHash) {
+    Objects.requireNonNull(pub, "pub");
+    Objects.requireNonNull(secret, "secret");
+    final byte[] publicKey = pub.getH();
+    if (publicKey.length != PUBLIC_KEY_LENGTH) {
+      throw new IllegalArgumentException("Expected Falcon-1024 public key");
+    }
+    final byte[] canonical =
+        Falcon1024ConsensusCrypto.signingBytes(
+            chainId, messageType, blockHeight, round, payloadHash);
+    final byte[] signature = Falcon1024ConsensusCrypto.sign(secret, random, canonical);
+    if (signature.length == 0 || signature.length > MAX_SIGNATURE_LENGTH) {
+      throw new IllegalStateException("Unexpected Falcon-1024 signature length");
+    }
+    // Do not permit a caller to pair an unrelated public key with a private key.
+    if (!Falcon1024ConsensusCrypto.verify(pub, canonical, signature)) {
+      throw new IllegalArgumentException("Falcon public/private key mismatch");
+    }
+    final ByteBuffer out = ByteBuffer.allocate(HEADER_SIZE + publicKey.length + 2 + signature.length);
+    out.put(MAGIC);
+    out.put(VERSION);
+    out.put((byte) messageType);
+    out.putLong(chainId);
+    out.putLong(blockHeight);
+    out.putInt(round);
+    out.put(payloadHash);
+    out.putShort((short) publicKey.length);
+    out.put(publicKey);
+    out.putShort((short) signature.length);
+    out.put(signature);
+    return out.array();
+  }
+
+  /**
+   * Decode, authorize the exact Falcon-1024 public key, and verify the real payload hash.
+   *
+   * @param expectedPayloadHash independently computed from the decoded QBFT payload/header
+   * @param allowedPublicKeys exact 1792-byte public keys of the genesis/active validators
+   * @throws IllegalArgumentException for all malformed or unauthorized messages
+   */
+  public static VerifiedMessage decodeAndVerify(
+      final byte[] wire,
+      final long expectedChainId,
+      final int expectedMessageType,
+      final byte[] expectedPayloadHash,
+      final Collection<byte[]> allowedPublicKeys) {
+    Objects.requireNonNull(wire, "wire");
+    Objects.requireNonNull(expectedPayloadHash, "expectedPayloadHash");
+    Objects.requireNonNull(allowedPublicKeys, "allowedPublicKeys");
+    if (wire.length < HEADER_SIZE + PUBLIC_KEY_LENGTH + 2 + 1
+        || wire.length > HEADER_SIZE + PUBLIC_KEY_LENGTH + 2 + MAX_SIGNATURE_LENGTH) {
+      throw new IllegalArgumentException("Invalid Falcon envelope size");
+    }
+
+    final ByteBuffer in = ByteBuffer.wrap(wire);
+    for (final byte b : MAGIC) {
+      if (in.get() != b) {
+        throw new IllegalArgumentException("Not a Falcon QBFT v1 envelope");
+      }
+    }
+    if (in.get() != VERSION) {
+      throw new IllegalArgumentException("Unsupported Falcon QBFT protocol version");
+    }
+    final int messageType = Byte.toUnsignedInt(in.get());
+    final long chainId = in.getLong();
+    final long blockHeight = in.getLong();
+    final int round = in.getInt();
+    final byte[] payloadHash = new byte[32];
+    in.get(payloadHash);
+    final int publicKeyLength = Short.toUnsignedInt(in.getShort());
+    if (publicKeyLength != PUBLIC_KEY_LENGTH || in.remaining() < PUBLIC_KEY_LENGTH + 2 + 1) {
+      throw new IllegalArgumentException("Invalid Falcon-1024 public key length");
+    }
+    final byte[] publicKey = new byte[PUBLIC_KEY_LENGTH];
+    in.get(publicKey);
+    final int signatureLength = Short.toUnsignedInt(in.getShort());
+    if (signatureLength == 0 || signatureLength > MAX_SIGNATURE_LENGTH
+        || signatureLength != in.remaining()) {
+      throw new IllegalArgumentException("Invalid Falcon-1024 signature length or trailing data");
+    }
+    final byte[] signature = new byte[signatureLength];
+    in.get(signature);
+
+    if (chainId != expectedChainId || messageType != expectedMessageType
+        || !MessageDigest.isEqual(payloadHash, expectedPayloadHash)) {
+      throw new IllegalArgumentException("Falcon QBFT message domain or payload mismatch");
+    }
+
+    boolean authorized = false;
+    for (final byte[] accepted : allowedPublicKeys) {
+      // Check exact key, not a self-asserted signer address.
+      if (accepted != null && accepted.length == PUBLIC_KEY_LENGTH) {
+        authorized |= MessageDigest.isEqual(publicKey, accepted);
+      }
+    }
+    if (!authorized) {
+      throw new IllegalArgumentException("Unknown Falcon QBFT validator key");
+    }
+    final FalconPublicKeyParameters publicKeyParameters =
+        new FalconPublicKeyParameters(FalconParameters.falcon_1024, publicKey);
+    final byte[] canonical;
+    try {
+      canonical = Falcon1024ConsensusCrypto.signingBytes(
+          chainId, messageType, blockHeight, round, payloadHash);
+      if (!Falcon1024ConsensusCrypto.verify(publicKeyParameters, canonical, signature)) {
+        throw new IllegalArgumentException("Invalid Falcon QBFT signature");
+      }
+    } catch (final RuntimeException malformedSignature) {
+      throw new IllegalArgumentException("Invalid Falcon QBFT signature/domain", malformedSignature);
+    }
+    return new VerifiedMessage(
+        messageType, chainId, blockHeight, round, validatorAddress(publicKey), payloadHash);
+  }
+
+  /**
+   * Derives a new validator address from its Falcon public key for a NEW experimental genesis.
+   * These addresses are not compatible with existing secp256k1 validator addresses.
+   */
+  public static byte[] validatorAddress(final byte[] publicKey) {
+    Objects.requireNonNull(publicKey, "publicKey");
+    if (publicKey.length != PUBLIC_KEY_LENGTH) {
+      throw new IllegalArgumentException("Expected Falcon-1024 raw public key");
+    }
+    final KeccakDigest hash = new KeccakDigest(256);
+    hash.update(publicKey, 0, publicKey.length);
+    final byte[] digest = new byte[32];
+    hash.doFinal(digest, 0);
+    return Arrays.copyOfRange(digest, 12, 32);
+  }
+
+  /** Proof of successful verification, not directly constructible by callers. */
+  public static final class VerifiedMessage {
+    private final int messageType;
+    private final long chainId;
+    private final long blockHeight;
+    private final int round;
+    private final byte[] authorAddress;
+    private final byte[] payloadHash;
+
+    private VerifiedMessage(
+        final int messageType,
+        final long chainId,
+        final long blockHeight,
+        final int round,
+        final byte[] authorAddress,
+        final byte[] payloadHash) {
+      this.messageType = messageType;
+      this.chainId = chainId;
+      this.blockHeight = blockHeight;
+      this.round = round;
+      this.authorAddress = authorAddress.clone();
+      this.payloadHash = payloadHash.clone();
+    }
+
+    public int messageType() {
+      return messageType;
+    }
+
+    public long chainId() {
+      return chainId;
+    }
+
+    public long blockHeight() {
+      return blockHeight;
+    }
+
+    public int round() {
+      return round;
+    }
+
+    public byte[] authorAddress() {
