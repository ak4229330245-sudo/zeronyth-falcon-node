diff --git a/zeronyth/falcon-net/explorer/server.mjs b/zeronyth/falcon-net/explorer/server.mjs
new file mode 100644
index 0000000..d6f9012
--- /dev/null
+++ b/zeronyth/falcon-net/explorer/server.mjs
@@ -0,0 +1,110 @@
+// ZERONYTH Falcon-QBFT LOCAL explorer + PQ verification API (chain 912701 test net ONLY).
+// Binds 127.0.0.1 only. Read-only: allowlisted RPC proxy, attester proxy, stateless verify API.
+// Holds no keys. Refuses production chain 9127 / production ports.
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import * as C from './falcon-verify-core.mjs';
+import { b64, ml_dsa65 } from '../tools/vendor/pq-finality-core.mjs';
+
+const dir = path.dirname(fileURLToPath(import.meta.url));
+const HOST = '127.0.0.1';
+const PORT = Number(process.env.EXPLORER_PORT || 18780);
+const RPC = process.env.RPC_URL || 'http://127.0.0.1:18601/';
+const ATTESTER = process.env.ATTESTER_URL || 'http://127.0.0.1:18799';
+if (/:(8545|8646|8647|8648|8799)\b/.test(RPC + ATTESTER) || [8545, 8799, 80, 443].includes(PORT)) throw new Error('refusing production ports');
+const RPC_ALLOW = new Set(['eth_chainId', 'eth_blockNumber', 'eth_getBlockByNumber', 'eth_getBlockByHash', 'net_peerCount', 'qbft_getValidatorsByBlockNumber', 'eth_syncing']);
+const log = (m) => process.stdout.write(`[EXPLORER] ${new Date().toISOString()} ${m}\n`);
+
+async function rpc(method, params = []) {
+  const r = await fetch(RPC, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }), signal: AbortSignal.timeout(5000) });
+  const j = await r.json(); if (j.error) throw new Error(j.error.message); return j.result;
+}
+async function chainGuard() {
+  const id = parseInt(await rpc('eth_chainId'), 16);
+  if (id !== C.TEST_CHAIN_ID) throw new Error(`connected chain ${id} is not the 912701 test net - refusing`);
+  return id;
+}
+const send = (res, code, obj, type = 'application/json') => {
+  res.writeHead(code, { 'content-type': type, 'cache-control': 'no-store', 'x-content-type-options': 'nosniff',
+    'content-security-policy': "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'" });
+  res.end(typeof obj === 'string' || Buffer.isBuffer(obj) ? obj : JSON.stringify(obj, (k, v) => (typeof v === 'bigint' ? v.toString() : v instanceof Uint8Array ? C.bytesToHex(v) : v)));
+};
+const body = (req) => new Promise((ok, no) => { let s = ''; req.on('data', (d) => { s += d; if (s.length > 2e6) { no(new Error('body too large')); req.destroy(); } }); req.on('end', () => { try { ok(s ? JSON.parse(s) : {}); } catch (e) { no(e); } }); });
+const getBlock = (n) => rpc('eth_getBlockByNumber', [typeof n === 'number' ? '0x' + n.toString(16) : n, false]);
+
+// Validator set per height via header-vote tally replay from genesis (decode-only; RPC-trust quick check).
+const setAt = new Map(); let tracker = null, replayed = -1;
+async function replayTo(n) {
+  if (!tracker) { const g = await getBlock(0); tracker = new C.ValidatorTracker(C.decodeExtra(g.extraData).validators); setAt.set(0, tracker.current()); setAt.set(1, tracker.current()); replayed = 0; }
+  while (replayed + 1 < n) {
+    const hs = []; for (let i = replayed + 1; i < Math.min(n, replayed + 65); i++) hs.push(i);
+    for (const blk of await Promise.all(hs.map(getBlock))) { const k = parseInt(blk.number, 16); tracker.apply(k, blk.miner, C.decodeExtra(blk.extraData).voteParsed); setAt.set(k + 1, tracker.current()); replayed = k; }
+  }
+}
+function nextAfter(num, b, falcon) { const t = tracker.clone(); if (replayed === num - 1) t.apply(num, b.miner, falcon.vote); else return setAt.get(num + 1) || setAt.get(num); return t.current(); }
+
+async function verifyBlockServer(n) {
+  await chainGuard();
+  const b = await getBlock(n); if (!b) throw new Error('block not found');
+  const num = parseInt(b.number, 16);
+  const parent = num > 0 ? await getBlock(num - 1) : null;
+  await replayTo(num);
+  const trusted = setAt.get(num);
+  const falcon = C.verifyFalconBlock(b, trusted, { parent });
+  falcon.nextValidators = nextAfter(num, b, falcon);
+  let registry = null, finality = { ok: false, status: 'UNAVAILABLE' };
+  try {
+    const reg = await (await fetch(`${ATTESTER}/validators`, { signal: AbortSignal.timeout(3000) })).json();
+    registry = C.verifyRegistry(reg, trusted);
+    const r = await fetch(`${ATTESTER}/finality/${num}`, { signal: AbortSignal.timeout(3000) });
+    if (r.ok) finality = { ...C.verifyFinalityCert(await r.json(), reg, b, falcon), status: 'CHECKED' };
+    else finality.status = `NO CERTIFICATE (HTTP ${r.status})`;
+  } catch (e) { finality.status = `ATTESTER NOT CONNECTED (${e.message})`; }
+  return { number: num, hash: b.hash, trustModel: 'validator set from header-vote tally replayed from genesis via RPC (server-side quick check; the browser page does full genesis-anchored Falcon-verified sync)',
+    falcon: { ok: falcon.ok, checks: falcon.checks, seals: falcon.seals.map(({ ok, reason, address, type, duplicate }) => ({ ok, reason, address, type, duplicate })) },
+    registry, finality, verdict: falcon.ok && finality.ok === true && registry?.ok ? 'VERIFIED' : falcon.ok ? 'FALCON_VERIFIED_PQ_FINALITY_NOT_VERIFIED' : 'FAILED' };
+}
+
+const STATIC = { '/': ['index.html', 'text/html; charset=utf-8'], '/app.js': ['dist/app.js', 'text/javascript; charset=utf-8'], '/style.css': ['style.css', 'text/css'], '/trust-anchor.json': ['trust-anchor.json', 'application/json'] };
+http.createServer(async (req, res) => {
+  const url = new URL(req.url, `http://${HOST}`);
+  try {
+    if (req.method === 'GET' && STATIC[url.pathname]) { const [f, t] = STATIC[url.pathname]; return send(res, 200, await readFile(path.join(dir, f)), t); }
+    if (req.method === 'POST' && url.pathname === '/rpc') {
+      const q = await body(req);
+      if (!RPC_ALLOW.has(q.method)) return send(res, 403, { jsonrpc: '2.0', id: q.id ?? null, error: { code: -32601, message: 'method not allowed by local explorer proxy' } });
+      try { return send(res, 200, { jsonrpc: '2.0', id: q.id ?? 1, result: await rpc(q.method, Array.isArray(q.params) ? q.params : []) }); }
+      catch (e) { return send(res, 502, { jsonrpc: '2.0', id: q.id ?? 1, error: { code: -32000, message: `node not connected: ${e.message}` } }); }
+    }
+    if (req.method === 'GET' && url.pathname.startsWith('/attester/')) {
+      const sub = url.pathname.slice('/attester'.length);
+      if (!/^\/(validators|stats|finality\/(latest|\d{1,12}))$/.test(sub)) return send(res, 404, { error: 'not found' });
+      try { const r = await fetch(ATTESTER + sub, { signal: AbortSignal.timeout(3000) }); return send(res, r.status, await r.text()); }
+      catch (e) { return send(res, 502, { error: `attester not connected: ${e.message}` }); }
+    }
+    // ---- local PQ verification API (stateless; never accepts or returns secrets) ----
+    if (req.method === 'GET' && url.pathname === '/v1/info') return send(res, 200, { falcon: C.ALGORITHM, mldsa: 'ML-DSA-65 (FIPS 204, @noble/post-quantum)', envelope: C.ENVELOPE, chainId: C.TEST_CHAIN_ID, fnDsa: 'not implemented: FIPS 206 FN-DSA not final; see docs/fn-dsa-migration.md' });
+    if (req.method === 'POST' && url.pathname === '/v1/verify/falcon') {
+      const q = await body(req); // {publicKey: hex raw 1792, message: hex, signature: hex}
+      return send(res, 200, { algorithm: C.ALGORITHM, valid: C.falconVerifyRaw(q.publicKey, q.message, q.signature), address: (() => { try { return C.addressOfFalconPub(q.publicKey); } catch { return null; } })() });
+    }
+    if (req.method === 'POST' && url.pathname === '/v1/verify/envelope') {
+      const q = await body(req); // {envelope hex, chainId, type, height, round, payloadHash, allowed?[]}
+      if (q.chainId === undefined) return send(res, 400, { error: 'chainId is required' });
+      return send(res, 200, C.verifyEnvelope(q.envelope, { chainId: q.chainId, type: q.type, height: q.height, round: q.round, payloadHash: q.payloadHash, allowed: q.allowed ? new Set(q.allowed.map((a) => a.toLowerCase())) : undefined }));
+    }
+    if (req.method === 'POST' && url.pathname === '/v1/verify/mldsa65') {
+      const q = await body(req); // {publicKey b64|hex, message hex, signature b64|hex}
+      const dec = (x) => (/^(0x)?[0-9a-fA-F]+$/.test(x) ? C.hexToBytes(x) : b64.dec(x));
+      let valid = false; try { valid = ml_dsa65.verify(dec(q.signature), C.hexToBytes(q.message), dec(q.publicKey)); } catch { valid = false; }
+      return send(res, 200, { algorithm: 'ML-DSA-65 (FIPS 204)', valid });
+    }
+    if (req.method === 'GET' && /^\/v1\/verify\/block\/(latest|\d{1,12})$/.test(url.pathname)) {
+      const n = url.pathname.split('/').pop();
+      return send(res, 200, await verifyBlockServer(n === 'latest' ? 'latest' : Number(n)));
+    }
+    return send(res, 404, { error: 'not found' });
+  } catch (e) { return send(res, 500, { error: String(e.message).slice(0, 300) }); }
+}).listen(PORT, HOST, () => log(`listening on http://${HOST}:${PORT} (rpc ${RPC}, attester ${ATTESTER})`));
