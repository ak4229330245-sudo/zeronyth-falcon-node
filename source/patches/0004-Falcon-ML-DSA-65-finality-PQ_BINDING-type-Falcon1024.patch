+package org.hyperledger.besu.crypto;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.util.HexFormat;
+import java.util.List;
+
+/**
+ * Helper for the off-chain ML-DSA-65 finality attester on a Falcon-QBFT chain. Prints only public
+ * data (addresses, public signatures); never prints key material.
+ *
+ * <pre>
+ * bind-sign &lt;falconKeyFile&gt; &lt;chainId&gt; &lt;hash32hex&gt;   -> Falcon PQ_BINDING envelope hex
+ * serve   (stdin lines, one reply line each):
+ *   seals &lt;chainId&gt; &lt;height&gt; &lt;round&gt; &lt;hash32hex&gt; &lt;seal1hex,seal2hex,...&gt; -> addr|x,...
+ *   bind  &lt;chainId&gt; &lt;hash32hex&gt; &lt;envelopehex&gt;                              -> addr|x
+ * </pre>
+ */
+public final class Falcon1024PqTool {
+  private static final HexFormat HEX = HexFormat.of();
+
+  private Falcon1024PqTool() {}
+
+  private static byte[] hex(final String s) {
+    return HEX.parseHex(s.startsWith("0x") ? s.substring(2) : s);
+  }
+
+  private static String verify(
+      final byte[] env,
+      final long chainId,
+      final int type,
+      final long h,
+      final int r,
+      final byte[] hash) {
+    try {
+      final Falcon1024ConsensusEnvelope.VerifiedMessage m =
+          Falcon1024ConsensusEnvelope.decodeAndVerify(
+              env, chainId, type, hash, List.of(Falcon1024ConsensusEnvelope.publicKeyOf(env)));
+      if (m.blockHeight() != h || m.round() != r || m.chainId() != chainId) {
+        return "x";
+      }
+      return "0x" + HEX.formatHex(m.authorAddress());
+    } catch (final RuntimeException e) {
+      return "x";
+    }
+  }
+
+  /**
+   * Entry point.
+   *
+   * @param args see class doc
+   * @throws Exception on I/O error
+   */
+  public static void main(final String[] args) throws Exception {
+    final PrintStream out = System.out;
+    if (args.length == 4 && args[0].equals("bind-sign")) {
+      final Falcon1024KeyFile.KeyPair kp = Falcon1024KeyFile.load(Path.of(args[1]));
+      final byte[] env =
+          Falcon1024ConsensusEnvelope.signAndEncode(
+              kp.secret(),
+              kp.pub(),
+              SecureRandomProvider.createSecureRandom(),
+              Long.parseLong(args[2]),
+              Falcon1024ConsensusCrypto.PQ_BINDING,
+              0,
+              0,
+              hex(args[3]));
+      out.println("0x" + HEX.formatHex(env));
+      return;
+    }
+    if (args.length == 1 && args[0].equals("serve")) {
+      final BufferedReader in =
+          new BufferedReader(new InputStreamReader(System.in, StandardCharsets.US_ASCII));
+      String line;
+      while ((line = in.readLine()) != null) {
+        final String[] p = line.trim().split(" ", -1);
+        try {
+          if (p[0].equals("seals") && p.length == 6) {
+            final long chainId = Long.parseLong(p[1]);
+            final long h = Long.parseLong(p[2]);
+            final int r = Integer.parseInt(p[3]);
+            final byte[] hash = hex(p[4]);
+            final StringBuilder sb = new StringBuilder();
+            for (final String s : p[5].split(",", -1)) {
+              if (sb.length() > 0) {
+                sb.append(',');
+              }
+              sb.append(verify(hex(s), chainId, Falcon1024ConsensusCrypto.COMMIT_SEAL, h, r, hash));
+            }
+            out.println(sb);
+          } else if (p[0].equals("bind") && p.length == 4) {
+            out.println(
+                verify(
+                    hex(p[3]),
+                    Long.parseLong(p[1]),
+                    Falcon1024ConsensusCrypto.PQ_BINDING,
+                    0,
+                    0,
+                    hex(p[2])));
+          } else {
+            out.println("ERR usage");
+          }
+        } catch (final RuntimeException e) {
+          out.println("ERR " + e.getClass().getSimpleName());
+        }
+        out.flush();
+      }
+      return;
+    }
+    System.err.println("usage: bind-sign <falconKeyFile> <chainId> <hash32hex> | serve");
+    System.exit(2);
+  }
+}
diff --git a/crypto/algorithms/src/test/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCryptoTest.java b/crypto/algorithms/src/test/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCryptoTest.java
index fbc0d21..d51be53 100644
--- a/crypto/algorithms/src/test/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCryptoTest.java
+++ b/crypto/algorithms/src/test/java/org/hyperledger/besu/crypto/Falcon1024ConsensusCryptoTest.java
@@ -83,9 +83,44 @@ class Falcon1024ConsensusCryptoTest {
   void rejectsMalformedSigningDomain() {
     assertThatThrownBy(() -> Falcon1024ConsensusCrypto.signingBytes(0, 1, 1, 0, new byte[32]))
         .isInstanceOf(IllegalArgumentException.class);
-    assertThatThrownBy(() -> Falcon1024ConsensusCrypto.signingBytes(9127, 6, 1, 0, new byte[32]))
+    assertThatThrownBy(() -> Falcon1024ConsensusCrypto.signingBytes(9127, 7, 1, 0, new byte[32]))
         .isInstanceOf(IllegalArgumentException.class);
     assertThatThrownBy(() -> Falcon1024ConsensusCrypto.signingBytes(9127, 1, 1, 0, new byte[31]))
         .isInstanceOf(IllegalArgumentException.class);
   }
+
+  @Test
+  void pqBindingEnvelopeIsNeverAcceptedAsConsensusSeal() {
+    final java.security.SecureRandom rnd = SecureRandomProvider.createSecureRandom();
+    final org.bouncycastle.crypto.AsymmetricCipherKeyPair kp =
+        Falcon1024ConsensusCrypto.generateKeyPair(rnd);
+    final org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters pub =
+        (org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters) kp.getPublic();
+    final byte[] hash = new byte[32];
+    hash[0] = 7;
+    final byte[] env =
+        Falcon1024ConsensusEnvelope.signAndEncode(
+            (org.bouncycastle.pqc.crypto.falcon.FalconPrivateKeyParameters) kp.getPrivate(),
+            pub,
+            rnd,
+            912701,
+            Falcon1024ConsensusCrypto.PQ_BINDING,
+            0,
+            0,
+            hash);
+    final java.util.List<byte[]> allowed = java.util.List.of(pub.getH());
+    org.assertj.core.api.Assertions.assertThat(
+            Falcon1024ConsensusEnvelope.decodeAndVerify(
+                    env, 912701, Falcon1024ConsensusCrypto.PQ_BINDING, hash, allowed)
+                .round())
+        .isZero();
+    for (int t = Falcon1024ConsensusCrypto.PROPOSAL;
+        t <= Falcon1024ConsensusCrypto.COMMIT_SEAL;
+        t++) {
+      final int type = t;
+      assertThatThrownBy(
+              () -> Falcon1024ConsensusEnvelope.decodeAndVerify(env, 912701, type, hash, allowed))
+          .isInstanceOf(IllegalArgumentException.class);
+    }
+  }
 }
diff --git a/zeronyth/README-falcon-qbft.md b/zeronyth/README-falcon-qbft.md
new file mode 100644
index 0000000..c0ca323
--- /dev/null
+++ b/zeronyth/README-falcon-qbft.md
@@ -0,0 +1,39 @@
+# ZERONYTH Falcon-1024 QBFT (experimental) — status and rollout plan
+
+Branch `zeronyth-falcon-qbft` on Besu 26.9.0. Falcon mode is enabled only by the genesis flag `qbft.falcon1024: true`.
+When the flag is off, upstream ECDSA QBFT behaviour is unchanged. EVM transaction signing (secp256k1) and devp2p stay
+unchanged. The experimental chain is 912701, not 9127. Production was not touched.
+
+## Design
+- Consensus messages (PROPOSAL, PREPARE, COMMIT, ROUND_CHANGE) and COMMIT seals are signed as "ZQBF" v1 Falcon-1024 envelopes.
+  - Each envelope is bound to the domain, chainId, message type, height, round and payload hash. Validator address = keccak(falconPub)[12..].
+  - Size: pubkey 1792 B, signature ~1270 B, ~3.1 KB per envelope. extraData with 3 seals is ~9.5 KB.
+- ML-DSA-65 finality is kept. It uses the same certificate format as `scripts/pq-finality.mjs` (`ZERONYTH-PQ-FINALITY-v1`).
+  The attester `falcon-net/tools/pq-finality-falcon.mjs` verifies Falcon seals with the Java helper `Falcon1024PqTool`.
+  It binds each ML-DSA key to its Falcon validator with a Falcon `PQ_BINDING` (type 6) envelope plus an ML-DSA signature.
+  The old ECDSA binding is not used.
+
+## Rollout plan for production chain 9127 (NOT executed)
+Chain 9127 cannot be hot-swapped. Its ECDSA-sealed history and validator addresses (from secp256k1 keys) would be rejected
+by Falcon-mode nodes, and Falcon blocks would be rejected by today's nodes. Mixing the two modes forks the network. Options:
+1. **New chain (recommended first).** Launch a new chain ID with a Falcon genesis and migrate state/apps, or bridge.
+   9127 keeps running as it is.
+2. **Hard fork at block N on 9127.** This needs new code (not implemented): a fork-scheduled switch, so that blocks < N
+   are verified with ECDSA and blocks >= N with Falcon. Block N-1 or N must also carry a validator-set transition to the
+   Falcon addresses. Every validator must upgrade before N, and the light client and pq-finality need dual-mode verification.
+Mandatory steps before touching 9127:
+- Full backup of every node's data dir and keys, with a restore test.
+- Rehearsal on a copy of the chain.
+- An exact change list.
+- **Explicit owner approval.**
+- A rollback plan: stop at N-1 and restore.
+- Generate the Falcon keys on each validator host. Never copy production keys elsewhere.
+- Encrypt the Falcon key file. Today it is unencrypted (0600).
+
+## Known limits / tech debt
+- bcprov 1.84 Falcon is round-3 Falcon, not final FIPS 206 FN-DSA. Re-key is needed when FN-DSA is final.
+- `Falcon1024Signature` is carried through the `SECPSignature` type. The mode is a static process-wide switch.
+- In Falcon mode, consensus messages are broadcast to all peers.
+- Validator voting (add/remove) in Falcon mode has not been tested.
+- The browser light client cannot verify Falcon seals. There is no JS Falcon verifier.
+- QBFT recovery from below-quorum is slow because of exponential round backoff. This is upstream behaviour, but there is no ECDSA baseline to compare against yet.
