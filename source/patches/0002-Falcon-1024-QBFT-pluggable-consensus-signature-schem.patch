+package org.hyperledger.besu.crypto;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.HashMap;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+
+import org.bouncycastle.crypto.AsymmetricCipherKeyPair;
+import org.bouncycastle.pqc.crypto.falcon.FalconParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPrivateKeyParameters;
+import org.bouncycastle.pqc.crypto.falcon.FalconPublicKeyParameters;
+
+/**
+ * Plain-text Falcon-1024 consensus key file (mode 0600). EXPERIMENTAL: the secret is NOT encrypted
+ * at rest; production use requires an encrypted keystore or HSM.
+ *
+ * <p>Format (one key=value per line): {@code format=falcon1024-v1, pub, f, g, F} (hex).
+ */
+public final class Falcon1024KeyFile {
+  private static final String FORMAT = "falcon1024-v1";
+
+  private Falcon1024KeyFile() {}
+
+  /** Loaded key pair. */
+  public record KeyPair(FalconPrivateKeyParameters secret, FalconPublicKeyParameters pub) {
+    /**
+     * Validator address = keccak256(pub)[12..32].
+     *
+     * @return 20-byte address
+     */
+    public byte[] address() {
+      return Falcon1024ConsensusEnvelope.validatorAddress(pub.getH());
+    }
+  }
+
+  /**
+   * Generates a key pair and writes it with owner-only permissions; refuses to overwrite.
+   *
+   * @param path target file
+   * @return the key pair
+   * @throws IOException on IO failure or if the file exists
+   */
+  public static KeyPair generate(final Path path) throws IOException {
+    final AsymmetricCipherKeyPair kp =
+        Falcon1024ConsensusCrypto.generateKeyPair(SecureRandomProvider.createSecureRandom());
+    final KeyPair pair =
+        new KeyPair(
+            (FalconPrivateKeyParameters) kp.getPrivate(),
+            (FalconPublicKeyParameters) kp.getPublic());
+    final HexFormat hex = HexFormat.of();
+    final String body =
+        "format="
+            + FORMAT
+            + "\npub="
+            + hex.formatHex(pair.pub().getH())
+            + "\nf="
+            + hex.formatHex(pair.secret().getSpolyf())
+            + "\ng="
+            + hex.formatHex(pair.secret().getG())
+            + "\nF="
+            + hex.formatHex(pair.secret().getSpolyF())
+            + "\n";
+    Files.createFile(
+        path, PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")));
+    Files.writeString(path, body, StandardCharsets.US_ASCII, StandardOpenOption.TRUNCATE_EXISTING);
+    return pair;
+  }
+
+  /**
+   * Loads and self-checks (sign + verify) a key file.
+   *
+   * @param path key file
+   * @return the key pair
+   * @throws IOException on IO failure
+   * @throws IllegalArgumentException on malformed or inconsistent keys
+   */
+  public static KeyPair load(final Path path) throws IOException {
+    final List<String> lines = Files.readAllLines(path, StandardCharsets.US_ASCII);
+    final Map<String, String> kv = new HashMap<>();
+    for (final String line : lines) {
+      final int i = line.indexOf('=');
+      if (i > 0) {
+        kv.put(line.substring(0, i).trim(), line.substring(i + 1).trim());
+      }
+    }
+    if (!FORMAT.equals(kv.get("format"))) {
+      throw new IllegalArgumentException("Not a " + FORMAT + " key file: " + path);
+    }
+    final HexFormat hex = HexFormat.of();
+    final byte[] pub = hex.parseHex(kv.get("pub"));
+    final FalconParameters p = FalconParameters.falcon_1024;
+    final FalconPublicKeyParameters pubKey = new FalconPublicKeyParameters(p, pub);
+    final FalconPrivateKeyParameters secret =
+        new FalconPrivateKeyParameters(
+            p,
+            hex.parseHex(kv.get("f")),
+            hex.parseHex(kv.get("g")),
+            hex.parseHex(kv.get("F")),
+            pub);
+    final byte[] probe = new byte[32];
+    final byte[] canonical =
+        Falcon1024ConsensusCrypto.signingBytes(1, Falcon1024ConsensusCrypto.PROPOSAL, 0, 0, probe);
+    final byte[] sig =
+        Falcon1024ConsensusCrypto.sign(
+            secret, SecureRandomProvider.createSecureRandom(), canonical);
+    if (!Falcon1024ConsensusCrypto.verify(pubKey, canonical, sig)) {
+      throw new IllegalArgumentException("Falcon key file public/secret mismatch: " + path);
+    }
+    return new KeyPair(secret, pubKey);
+  }
+
+  /**
+   * CLI: {@code generate <file>} creates a key and prints ONLY the public key hex and address.
+   *
+   * @param args arguments
+   * @throws Exception on failure
+   */
+  public static void main(final String[] args) throws Exception {
+    if (args.length != 2 || !"generate".equals(args[0])) {
+      System.err.println("usage: Falcon1024KeyFile generate <keyfile>");
+      System.exit(2);
+    }
+    final KeyPair kp = generate(Path.of(args[1]));
+    System.out.println("address=0x" + HexFormat.of().formatHex(kp.address()));
+    System.out.println("pub=" + HexFormat.of().formatHex(kp.pub().getH()));
+  }
+}
