+
+# usage: start-node.sh <i>   (experimental Falcon-only QBFT, chainId 912701; loopback only)
+i=$1; N=/workspace/falcon-qbft/net; source /workspace/falcon-qbft/env.sh
+export PATH=$JAVA_HOME/bin:$PATH BESU_OPTS="-Xmx768m -XX:+UseG1GC"
+mkdir -p $N/logs
+nohup /workspace/falcon-qbft/besu/build/install/besu/bin/besu \
+  --genesis-file=$N/genesis-falcon-912701.json --network-id=912701 \
+  --data-path=$N/node$i/data --static-nodes-file=$N/node$i/static-nodes.json \
+  --discovery-enabled=false --nat-method=NONE \
+  --p2p-host=127.0.0.1 --p2p-port=$((31300+i)) \
+  --rpc-http-enabled --rpc-http-host=127.0.0.1 --rpc-http-port=$((18600+i)) \
+  --rpc-http-api=ETH,NET,QBFT,ADMIN,TXPOOL,WEB3 --host-allowlist=localhost,127.0.0.1 \
+  --min-gas-price=0 --sync-mode=FULL --tx-pool-max-future-by-sender=5000 \
+  >> $N/logs/node$i.log 2>&1 &
+echo $! > $N/node$i.pid
+echo "node$i pid $(cat $N/node$i.pid) p2p $((31300+i)) rpc $((18600+i))"
