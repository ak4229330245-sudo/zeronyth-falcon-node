+#!/bin/bash
+# partition test via admin_removePeer/admin_addPeer (no iptables). usage: partition.sh cut|heal "1 2" "3 4"
+cd /workspace/falcon-qbft/net; op=$1; A=($2); B=($3)
+en(){ ./tools/rpc.sh $((18600+$1)) admin_nodeInfo | grep -o '"enode":"[^"]*"' | head -1 | cut -d'"' -f4; }
+m=admin_removePeer; [ "$op" = heal ] && m=admin_addPeer
+for a in "${A[@]}"; do for b in "${B[@]}"; do
+  ./tools/rpc.sh $((18600+a)) $m "[\"$(en $b)\"]" >/dev/null; ./tools/rpc.sh $((18600+b)) $m "[\"$(en $a)\"]" >/dev/null; done; done
+for i in "${A[@]}" "${B[@]}"; do echo "node$i peers=$(( $(./tools/rpc.sh $((18600+i)) net_peerCount | sed -n 's/.*"result":"\(0x[0-9a-f]*\)".*/\1/p') ))"; done
