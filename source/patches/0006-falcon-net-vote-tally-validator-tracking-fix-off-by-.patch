--- /dev/null
+++ b/zeronyth/falcon-net/tools/leak-scan.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Leak scan: searches logs, RPC/API responses and process cmdline/environ for fragments of
+Falcon secret keys (f,g,F), ML-DSA seeds and key passwords. Prints COUNTS ONLY, never secrets."""
+import glob, json, os, subprocess, urllib.request
+N = '/workspace/falcon-qbft/net'
+needles = []
+for f in glob.glob(N + '/secrets/rollback-plaintext/*.key'):
+    kv = dict(l.split('=', 1) for l in open(f).read().split('\n') if '=' in l)
+    for k in ('f', 'g', 'F'):
+        h = kv[k].strip().lower()
+        needles += [h[o:o + 24] for o in range(0, len(h) - 24, max(24, len(h) // 6))]
+for f in glob.glob(N + '/node*/data/pq-mldsa65.seed'):
+    h = open(f, 'rb').read().hex(); needles += [h[:24], h[24:48]]
+for f in glob.glob(N + '/secrets/*.pass'):
+    p = open(f).read().strip(); needles += [p[:16], p[16:32]]
+needles = [n for n in needles if len(n) >= 16]
+def scan(name, data):
+    data = data.lower() if isinstance(data, str) else data.decode('latin1').lower()
+    hits = sum(1 for n in needles if n.lower() in data)
+    print(f'{name:60s} bytes={len(data):>10d} hits={hits}'); return hits
+total = 0
+for f in sorted(glob.glob(N + '/logs/*.log') + glob.glob('/workspace/falcon-qbft/logs/*.log') + glob.glob(N + '/pq/*')):
+    total += scan(os.path.relpath(f, '/workspace/falcon-qbft'), open(f, 'rb').read())
+def rpc(port, m, p=[]):
+    r = urllib.request.Request(f'http://127.0.0.1:{port}/', json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': m, 'params': p}).encode(), {'content-type': 'application/json'})
+    return urllib.request.urlopen(r, timeout=5).read()
+for port in (18601, 18602, 18603, 18604):
+    for m, p in [('admin_nodeInfo', []), ('admin_peers', []), ('qbft_getValidatorsByBlockNumber', ['latest']), ('eth_getBlockByNumber', ['latest', True]), ('qbft_getPendingVotes', [])]:
+        try: total += scan(f'rpc:{port} {m}', rpc(port, m, p))
+        except Exception as e: print(f'rpc:{port} {m} error {type(e).__name__}')
+for u in ['http://127.0.0.1:18799/validators', 'http://127.0.0.1:18799/stats', 'http://127.0.0.1:18799/finality/latest', 'http://127.0.0.1:18780/v1/verify/block/latest', 'http://127.0.0.1:18780/v1/info']:
+    try: total += scan(u, urllib.request.urlopen(u, timeout=10).read())
+    except Exception as e: print(f'{u} error {type(e).__name__}')
+for pidf in glob.glob(N + '/node*.pid'):
+    pid = open(pidf).read().strip()
+    for part in ('cmdline', 'environ'):
+        try: total += scan(f'/proc/{pid}/{part} ({os.path.basename(pidf)})', open(f'/proc/{pid}/{part}', 'rb').read())
+        except Exception as e: print(f'/proc/{pid}/{part} {type(e).__name__}')
+print(f'needles={len(needles)} TOTAL_HITS={total}')
diff --git a/zeronyth/falcon-net/tools/migrate-keys-encrypted.sh b/zeronyth/falcon-net/tools/migrate-keys-encrypted.sh
new file mode 100755
index 0000000..0358bbd
--- /dev/null
+++ b/zeronyth/falcon-net/tools/migrate-keys-encrypted.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+# One-time: wrap net/nodeN/data/falcon1024.key (plaintext falcon1024-v1) into falcon1024-enc-v1 in place.
+# Password files: net/secrets/nodeN.pass (0600, dir 0700, random 32 bytes base64, never printed).
+# Plaintext originals are moved to net/secrets/rollback-plaintext/ (0600) for rollback only.
+set -euo pipefail
+N=/workspace/falcon-qbft/net; umask 077
+mkdir -p $N/secrets/rollback-plaintext; chmod 700 $N/secrets $N/secrets/rollback-plaintext
+for i in "$@"; do
+  d=$N/node$i/data; k=$d/falcon1024.key; pw=$N/secrets/node$i.pass
+  [ -f "$pw" ] || { head -c 32 /dev/urandom | base64 > "$pw"; chmod 600 "$pw"; }
+  if grep -q '^format=falcon1024-enc-v1' "$k"; then echo "node$i already encrypted"; continue; fi
+  BESU_FALCON1024_KEY_PASSWORD_FILE=$pw $N/tools/falcon-key.sh encrypt "$k" "$d/falcon1024.key.enc.tmp" | grep -E '^(format|encrypted|address)='
+  a1=$($N/tools/falcon-key.sh info "$k" | grep ^address=); a2=$($N/tools/falcon-key.sh info "$d/falcon1024.key.enc.tmp" | grep ^address=)
+  [ "$a1" = "$a2" ] || { echo "address mismatch node$i"; exit 1; }
+  BESU_FALCON1024_KEY_PASSWORD_FILE=$pw $N/tools/falcon-key.sh verify "$d/falcon1024.key.enc.tmp" | grep -E '^selfcheck'
+  cp -p "$k" $N/secrets/rollback-plaintext/node$i.falcon1024.key
+  mv "$d/falcon1024.key.enc.tmp" "$k"; chmod 600 "$k"
+  echo "node$i migrated ($a1)"
+done
