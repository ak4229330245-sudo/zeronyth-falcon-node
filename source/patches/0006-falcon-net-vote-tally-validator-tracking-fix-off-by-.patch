+#!/bin/bash
+# start|stop|status the ML-DSA-65 finality attester for the Falcon test net (127.0.0.1:18799, 912701 only)
+R=/workspace/falcon-qbft; P=$R/net/pq/attester.pid; L=$R/logs/pq-falcon-attester-2.log
+case "$1" in
+start) if [ -f $P ] && kill -0 $(cat $P) 2>/dev/null; then echo "already running $(cat $P)"; exit 0; fi
+  source $R/env.sh; export PATH=$JAVA_HOME/bin:$PATH; cd $R; nohup node net/tools/pq-finality-falcon.mjs >> $L 2>&1 & echo $! > $P; sleep 6; tail -3 $L | cut -c1-200 ;;
+stop) p=$(cat $P 2>/dev/null); [ -n "$p" ] && grep -q pq-finality-falcon /proc/$p/cmdline 2>/dev/null && kill $p; rm -f $P; echo stopped ;;
