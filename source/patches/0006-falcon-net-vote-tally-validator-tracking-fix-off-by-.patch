+++ b/zeronyth/falcon-net/tools/perf.mjs
@@ -0,0 +1,26 @@
+// propagation + block interval + per-node CPU/RSS sampler (test net 912701 only, ports 18601-18604)
+import { readFileSync } from 'node:fs';
+const PORTS = [18601, 18602, 18603, 18604]; const DUR = Number(process.argv[2] || 60) * 1000;
+const rpc = async (p, m, a = []) => (await (await fetch(`http://127.0.0.1:${p}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: m, params: a }) })).json()).result;
+const cid = parseInt(await rpc(PORTS[0], 'eth_chainId'), 16); if (cid !== 912701) throw new Error('not test chain');
