+// Node-side replay of the exact browser verification path: genesis-anchored, Falcon seals + vote-tally validator sets.
+import * as C from './falcon-verify-core.mjs';
+const RPC = process.env.RPC_URL || 'http://127.0.0.1:18601';
+const rpc = async (m, a = []) => (await (await fetch(RPC, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: m, params: a }) })).json()).result;
+if (parseInt(await rpc('eth_chainId'), 16) !== 912701) throw new Error('not 912701');
+const getBlock = (n) => rpc('eth_getBlockByNumber', ['0x' + n.toString(16), false]);
+const g = await getBlock(0); const t = new C.ValidatorTracker(C.decodeExtra(g.extraData).validators);
+const head = parseInt(await rpc('eth_blockNumber'), 16); let parent = { hash: g.hash }, fails = [], changes = [], seals = 0; const t0 = performance.now();
+for (let n = 1; n <= head; n += 64) {
+  const bs = await Promise.all(Array.from({ length: Math.min(64, head - n + 1) }, (_, k) => getBlock(n + k)));
+  for (const b of bs) { const num = parseInt(b.number, 16); const before = t.current();
+    const r = C.verifyFalconBlock(b, before, { parent }); seals += r.seals.length;
+    if (!r.ok) fails.push({ num, bad: r.checks.filter((c) => !c.ok).map((c) => c.name) });
+    t.apply(num, b.miner, r.vote); const after = t.current();
+    if (after.join() !== before.join()) changes.push({ appliedAtBlock: num, effectiveFrom: num + 1, size: `${before.length}->${after.length}` });
+    parent = b; }
+}
+// negative: claim the old 5-set for block 2927 / drop a validator from the claimed set
+const b2927 = await getBlock(2927), five = [...C.decodeExtra((await getBlock(2926)).extraData).validators];
+const neg1 = C.verifyFalconBlock(b2927, five, { parent: await getBlock(2926) }).ok;
+console.log(JSON.stringify({ head, blocksVerified: head, sealsVerified: seals, ms: Math.round(performance.now() - t0), failures: fails.slice(0, 5), failureCount: fails.length, validatorChanges: changes, wrongSetFor2927Rejected: !neg1 }));
