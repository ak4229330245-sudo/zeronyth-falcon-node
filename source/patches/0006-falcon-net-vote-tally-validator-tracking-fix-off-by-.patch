diff --git a/zeronyth/falcon-net/explorer/app.mjs b/zeronyth/falcon-net/explorer/app.mjs
new file mode 100644
index 0000000..d82fb32
--- /dev/null
+++ b/zeronyth/falcon-net/explorer/app.mjs
@@ -0,0 +1,147 @@
+// Browser client: all Falcon-1024 and ML-DSA-65 verification runs HERE, in the browser.
+// The server only proxies read-only data; nothing it says is trusted as "verified".
+import * as C from './falcon-verify-core.mjs';
+
+const $ = (id) => document.getElementById(id);
+const el = (tag, attrs = {}, ...kids) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v); for (const k of kids) e.append(k); return e; };
+const STATE = { NOT_CONNECTED: 'NOT CONNECTED', UNVERIFIED: 'UNVERIFIED', FAILED: 'FAILED', VERIFIED: 'VERIFIED', PARTIAL: 'FALCON OK / PQ NOT VERIFIED', SYNCING: 'SYNCING' };
+const badge = (s) => el('span', { class: 'badge ' + ({ 'VERIFIED': 'ok', 'FAILED': 'bad', 'NOT CONNECTED': 'nc' }[s] || 'warn') }, s);
+const okx = (b) => el('span', { class: b ? 'ok-t' : 'bad-t' }, b ? 'OK' : 'NG');
+
+let rpcId = 0;
+async function rpc(method, params = []) {
+  const r = await fetch('/rpc', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: ++rpcId, method, params }) });
+  const j = await r.json(); if (j.error) throw new Error(j.error.message); return j.result;
+}
+const getBlock = (n) => rpc('eth_getBlockByNumber', ['0x' + n.toString(16), false]);
+
+const chain = { anchor: null, verified: new Map(), trustedAt: new Map(), head: -1, failedAt: null, reg: null, regResult: null, connected: false };
+
+function setConn(state, text) { $('conn').replaceChildren(badge(state), ' ', text); }
+
+async function connect() {
+  try {
+    const id = parseInt(await rpc('eth_chainId'), 16);
+    if (id !== C.TEST_CHAIN_ID) { setConn(STATE.FAILED, `connected chain ${id} is NOT the 912701 test net - verification refused`); chain.connected = false; return false; }
+    chain.anchor = await (await fetch('/trust-anchor.json')).json();
+    const g = await getBlock(0);
+    if (g.hash.toLowerCase() !== chain.anchor.genesisHash.toLowerCase()) { setConn(STATE.FAILED, 'genesis hash does not match pinned trust anchor'); return false; }
+    chain.genesis = g; chain.tracker = new C.ValidatorTracker(C.decodeExtra(g.extraData).validators, chain.anchor.epochLength || 30000);
+    chain.trustedAt.set(0, chain.tracker.current()); chain.trustedAt.set(1, chain.tracker.current());
+    chain.verified.set(0, { ok: true, number: 0, hash: g.hash, nextValidators: C.decodeExtra(g.extraData).validators, genesis: true });
+    chain.connected = true;
+    setConn('CONNECTED', `chain ${id} (isolated Falcon-QBFT test net), genesis ${g.hash.slice(0, 18)}… pinned`);
+    return true;
+  } catch (e) { chain.connected = false; setConn(STATE.NOT_CONNECTED, `node RPC not reachable: ${e.message}`); return false; }
+}
+
+async function loadRegistry() {
+  try {
+    const r = await fetch('/attester/validators'); if (!r.ok) throw new Error('HTTP ' + r.status);
+    chain.reg = await r.json();
+    chain.regResult = C.verifyRegistry(chain.reg, chain.trustedAt.get(1));
+    $('reg').replaceChildren(badge(chain.regResult.ok ? STATE.VERIFIED : STATE.FAILED), ` ML-DSA-65 registry: ${chain.regResult.entries.length} keys, Falcon bindings + ML-DSA PoP verified in browser, setHash ${chain.regResult.setHashOk ? 'OK' : 'MISMATCH'}`);
+  } catch (e) { chain.reg = null; chain.regResult = null; $('reg').replaceChildren(badge(STATE.NOT_CONNECTED), ` PQ attester not reachable (${e.message}) - ML-DSA finality cannot be verified`); }
+}
+
+// Genesis-anchored sync: each header must hash correctly, link to its verified parent and carry
+// Falcon COMMIT seals from >= quorum of the validator set derived from the verified chain.
+// Re-entrancy guard: overlapping passes would apply validator votes twice (wrong set) and could
+// overwrite a FAILED badge with VERIFIED. Only one pass may run; FAILED is terminal.
+async function sync() {
+  if (!chain.connected || chain.failedAt !== null || chain.syncing) return;
+  chain.syncing = true;
+  try { await syncPass(); } finally { chain.syncing = false; }
+}
+async function syncPass() {
+  const head = parseInt(await rpc('eth_blockNumber'), 16);
+  let next = Math.max(...chain.verified.keys()) + 1;
+  const t0 = performance.now(); let n = 0;
+  while (next <= head) {
+    const batch = []; for (let i = next; i <= Math.min(head, next + 31); i++) batch.push(i);
+    const blocks = await Promise.all(batch.map(getBlock));
+    for (const b of blocks) {
+      const num = parseInt(b.number, 16), parent = chain.verified.get(num - 1);
+      if (chain.verified.has(num) || !parent) { chain.failedAt = num; $('sync').replaceChildren(badge(STATE.FAILED), ` internal sync order error at block ${num}`); return; }
+      const res = C.verifyFalconBlock(b, chain.trustedAt.get(num), { parent });
+      res.block = b; chain.verified.set(num, res);
+      if (!res.ok) { chain.failedAt = num; $('sync').replaceChildren(badge(STATE.FAILED), ` chain verification FAILED at block ${num}: ${res.checks.filter((c) => !c.ok).map((c) => c.name).join('; ')}`); return; }
+      chain.tracker.apply(num, b.miner, res.vote); res.nextValidators = chain.tracker.current();
+      chain.trustedAt.set(num + 1, res.nextValidators);
+      if (num - 3000 > 0) chain.verified.delete(num - 3000);
+      n++;
+    }
+    next = batch[batch.length - 1] + 1;
+    $('sync').replaceChildren(badge(STATE.SYNCING), ` verified ${next - 1}/${head} headers from genesis (${n} this pass)`);
+    await new Promise((r) => setTimeout(r, 0));
+  }
+  if (chain.failedAt !== null) return;
+  chain.head = head;
+  const ms = performance.now() - t0;
+  $('sync').replaceChildren(badge(STATE.VERIFIED), ` header chain 0..${head} verified from pinned genesis in this browser (Falcon-1024 seals, quorum, hash links)${n ? `, ${n} blocks in ${(ms / 1000).toFixed(1)} s` : ''}`);
+}
+
+async function finalityFor(num, falconRes) {
+  if (!chain.reg || !chain.regResult?.ok) return { state: STATE.UNVERIFIED, why: 'PQ registry not verified' };
+  try {
+    const r = await fetch('/attester/finality/' + num);
+    if (!r.ok) return { state: STATE.UNVERIFIED, why: `no ML-DSA certificate (HTTP ${r.status})` };
+    const v = C.verifyFinalityCert(await r.json(), chain.reg, falconRes.block, falconRes);
+    return { state: v.ok ? STATE.VERIFIED : STATE.FAILED, v };
+  } catch (e) { return { state: STATE.NOT_CONNECTED, why: e.message }; }
+}
+
+async function renderList() {
+  const tbody = $('blocks'); const rows = [];
+  for (let num = chain.head; num >= Math.max(1, chain.head - 14); num--) {
+    const r = chain.verified.get(num);
+    let st = STATE.UNVERIFIED, fin = null;
+    if (r) { if (!r.ok) st = STATE.FAILED; else { fin = await finalityFor(num, r); st = fin.state === STATE.VERIFIED ? STATE.VERIFIED : fin.state === STATE.FAILED ? STATE.FAILED : STATE.PARTIAL; } }
+    const tr = el('tr', { class: 'row', 'data-n': String(num) },
+      el('td', {}, String(num)), el('td', { class: 'mono' }, r ? r.hash.slice(0, 18) + '…' : '-'),
+      el('td', {}, r ? `${r.validSigners.length}/${r.need} of ${r.validatorCount}` : '-'),
+      el('td', {}, r?.vote ? `${r.vote.add ? 'ADD' : 'REMOVE'} ${r.vote.address.slice(0, 10)}…` : ''),
+      el('td', {}, fin ? (fin.state === STATE.VERIFIED ? `${fin.v.validSignatures}/${fin.v.need}` : fin.why || fin.state) : '-'),
+      el('td', {}, badge(st)));
+    tr.onclick = () => renderDetail(num);
+    rows.push(tr);
+  }
+  tbody.replaceChildren(...rows);
+}
+
+async function renderDetail(num, tamper = false) {
+  const d = $('detail');
+  let r = chain.verified.get(num);
+  if (!r) { d.replaceChildren(badge(STATE.UNVERIFIED), ` block ${num} not verified yet`); return; }
+  if (tamper) { // local negative test: flip one byte of seal #0 signature and re-verify
+    const e = C.decodeExtra(r.block.extraData);
+    const bad = Uint8Array.from(e.seals[0]); bad[bad.length - 7] ^= 0x01;
+    const res = C.verifyEnvelope(bad, { chainId: C.TEST_CHAIN_ID, type: C.COMMIT_SEAL, height: num, round: e.roundNumber, payloadHash: C.qbftSealHash(r.block, e), allowed: new Set(chain.trustedAt.get(num)) });
+    d.replaceChildren(el('h3', {}, `Tamper self-test on block ${num}`), el('p', {}, 'Seal #0 with one flipped signature byte: '), badge(res.ok ? STATE.VERIFIED : STATE.FAILED), el('p', {}, `reason: ${res.reason}`), el('p', {}, res.ok ? 'BUG: tampered seal accepted' : 'Expected: tampered seal is rejected.'));
+    return;
+  }
+  const fin = await finalityFor(num, r);
+  const sealRows = r.seals.map((s, i) => el('tr', {}, el('td', {}, String(i)), el('td', { class: 'mono' }, s.address || '-'),
+    el('td', { class: 'mono' }, s.publicKeyHex ? s.publicKeyHex.slice(0, 14) + '…' : '-'),
+    el('td', {}, okx(s.ok && C.addressOfFalconPub(s.publicKeyHex) === s.address)), el('td', {}, okx(s.ok && chain.trustedAt.get(num).includes(s.address))),
+    el('td', {}, okx(s.ok)), el('td', {}, s.ok ? `${s.sigLen} B` : s.reason)));
+  const checks = (list) => el('ul', {}, ...list.map((c) => el('li', {}, okx(c.ok), ' ', c.name)));
+  d.replaceChildren(
+    el('h3', {}, `Block ${num} `, badge(!r.ok ? STATE.FAILED : fin.state === STATE.VERIFIED ? STATE.VERIFIED : fin.state === STATE.FAILED ? STATE.FAILED : STATE.PARTIAL)),
+    el('p', { class: 'mono' }, r.hash), el('p', {}, `round ${r.round}; validator set (from verified parent): ${chain.trustedAt.get(num).length}`),
+    el('h4', {}, 'Falcon-1024 COMMIT seals (verified in browser, round-3 Falcon / BouncyCastle-compatible, not FIPS 206)'),
+    el('table', {}, el('tr', {}, ...['#', 'signer', 'Falcon public key', 'keccak(pub)=signer', 'in validator set', 'signature', 'detail'].map((h) => el('th', {}, h))), ...sealRows),
+    checks(r.checks),
+    el('h4', {}, 'ML-DSA-65 finality certificate'),
+    fin.v ? checks(fin.v.checks) : el('p', {}, badge(fin.state), ' ', fin.why || ''),
+    el('button', { id: 'tamper' }, 'Run tamper self-test on this block'));
+  $('tamper').onclick = () => renderDetail(num, true);
+}
+
+async function tick() {
+  if (!chain.connected) { if (!(await connect())) return; await loadRegistry(); }
+  try { await sync(); await renderList(); } catch (e) { chain.connected = false; setConn(STATE.NOT_CONNECTED, e.message); $('sync').replaceChildren(badge(STATE.UNVERIFIED), ' sync paused'); }
+}
+setConn(STATE.NOT_CONNECTED, 'connecting…'); $('sync').replaceChildren(badge(STATE.UNVERIFIED), ' not started'); $('reg').replaceChildren(badge(STATE.UNVERIFIED), ' not loaded');
+tick(); setInterval(tick, 4000);
+window.__explorer = chain; // for automated checks
diff --git a/zeronyth/falcon-net/explorer/ctl.sh b/zeronyth/falcon-net/explorer/ctl.sh
